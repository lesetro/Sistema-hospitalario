//- views/dashboard/enfermero/lista-espera.pug
extends ../../layouts/enfermero-layout

block content
  .container-fluid
    // Header con información del sector
    .row.mb-4
      .col-12
        .d-flex.justify-content-between.align-items-center
          div
            h2.mb-1
              i.fas.fa-list-ol.me-2
              | Lista de Espera 
              if enfermeroInfo && enfermeroInfo.sector
                span.text-muted | Sector: #{enfermeroInfo.sector}
            p.text-muted.mb-0 
              | Pacientes pendientes en 
              if enfermeroInfo && enfermeroInfo.sector
                strong #{enfermeroInfo.sector}
              else
                | su sector asignado
          div
           
            a.btn.btn-outline-primary.ms-2(href='/enfermero/triaje')
              i.fas.fa-stethoscope.me-2
              | Ir a Triaje

    // Estadísticas DEL SECTOR
    .row.g-3.mb-4
      .col-md-3.col-sm-6
        .card.border-0.shadow-sm.text-center
          .card-body
            h3.mb-0= estadisticas ? estadisticas.total || 0 : 0
            small.text-muted Total en Sector
      
      .col-md-3.col-sm-6
        .card.border-0.shadow-sm.border-start.border-warning.border-4.text-center
          .card-body
            h3.mb-0.text-warning= estadisticas ? estadisticas.pendientes || 0 : 0
            small.text-muted Pendientes
      
      .col-md-3.col-sm-6
        .card.border-0.shadow-sm.border-start.border-danger.border-4.text-center
          .card-body
            h3.mb-0.text-danger= estadisticas ? estadisticas.urgentes || 0 : 0
            small.text-muted Urgentes (ALTA)
      
      .col-md-3.col-sm-6
        .card.border-0.shadow-sm.border-start.border-info.border-4.text-center
          .card-body
            h3.mb-0.text-info= estadisticas ? estadisticas.asignados || 0 : 0
            small.text-muted Con Turno Asignado

    // Alerta informativa ESPECÍFICA
    .row.mb-3
      .col-12
        .alert.alert-info.d-flex.align-items-center
          i.fas.fa-info-circle.fa-2x.me-3
          div
            if enfermeroInfo && enfermeroInfo.nombre
              strong Atención #{enfermeroInfo.nombre}:
            else
              strong Atención Enfermero/a:
            |  Esta vista muestra SOLO los pacientes del sector 
            if enfermeroInfo && enfermeroInfo.sector
              strong #{enfermeroInfo.sector}
            else
              | su sector asignado
            | . Puede realizar el triaje de pacientes nuevos o verificar el estado de los ya atendidos.

    // Filtros (SIMPLIFICADOS - sin selector de sector)
    .row.mb-3
      .col-12
        .card.border-0.shadow-sm
          .card-body
            form#form-filtros.row.g-3(method='GET')
              //- Campo oculto con el sector del enfermero
              if enfermeroInfo && enfermeroInfo.sector_id
                input(type='hidden' name='sector_id' value=enfermeroInfo.sector_id)
              
              .col-md-4
                label.form-label Tipo de Turno
                select.form-select(name='tipo_turno')
                  option(value='' selected=!filtros || !filtros.tipo_turno) Todos
                  if tiposTurno && tiposTurno.length > 0
                    each tipo in tiposTurno
                      option(value=tipo.id selected=(filtros && filtros.tipo_turno == tipo.id))= tipo.nombre
              
              .col-md-4
                label.form-label Prioridad
                select.form-select(name='prioridad')
                  option(value='' selected=!filtros || !filtros.prioridad) Todas
                  option(value='ALTA' selected=(filtros && filtros.prioridad === 'ALTA')) Alta (Urgente)
                  option(value='MEDIA' selected=(filtros && filtros.prioridad === 'MEDIA')) Media
                  option(value='BAJA' selected=(filtros && filtros.prioridad === 'BAJA')) Baja
              
              .col-md-4
                label.form-label Estado
                select.form-select(name='estado')
                  option(value='' selected=!filtros || !filtros.estado) Todos
                  option(value='PENDIENTE' selected=(filtros && filtros.estado === 'PENDIENTE')) Pendientes
                  option(value='ASIGNADO' selected=(filtros && filtros.estado === 'ASIGNADO')) Con Turno
                  option(value='COMPLETADO' selected=(filtros && filtros.estado === 'COMPLETADO')) Completados
              
              .col-12.d-flex.justify-content-between
                .input-group(style='max-width: 400px')
                  input.form-control(type='text' id='buscar-paciente' placeholder='Buscar por DNI o nombre...')
                  button.btn.btn-outline-primary(type='button' onclick='buscarPaciente()')
                    i.fas.fa-search
                div
                  button.btn.btn-primary.me-2(type='submit')
                    i.fas.fa-filter.me-2
                    | Aplicar Filtros
                  button.btn.btn-secondary(type='button' onclick='limpiarFiltros()')
                    i.fas.fa-times.me-2
                    | Limpiar

    // Lista de espera DEL SECTOR
    .row
      .col-12
        .card.border-0.shadow-sm
          .card-header.bg-white.d-flex.justify-content-between.align-items-center
            h5.mb-0
              i.fas.fa-list.me-2
              if enfermeroInfo && enfermeroInfo.sector
                | Pacientes en #{enfermeroInfo.sector}
              else
                | Pacientes en su sector
            if listaEspera && listaEspera.length > 0
              small.text-muted Mostrando #{listaEspera.length} registro(s)
          .card-body.p-0
            if listaEspera && listaEspera.length > 0
              .table-responsive
                table.table.table-hover.mb-0#tabla-lista-espera
                  thead.table-light
                    tr
                      th(style="width: 10%") Prioridad
                      th(style="width: 20%") Paciente
                      th(style="width: 10%") DNI
                      th(style="width: 15%") Tipo
                      th(style="width: 20%") Información
                      th(style="width: 10%") Tiempo
                      th(style="width: 10%") Estado
                      th(style="width: 15%") Acciones
                  tbody
                    each registro in listaEspera
                      - const rowClass = registro.prioridad === 'ALTA' ? 'table-danger' : registro.prioridad === 'MEDIA' ? 'table-warning' : ''
                      - const tiempoEsperaMins = registro.fecha_registro ? Math.floor((new Date() - new Date(registro.fecha_registro)) / (1000 * 60)) : 0
                      - const horas = Math.floor(tiempoEsperaMins / 60)
                      - const minutos = tiempoEsperaMins % 60
                      - const necesitaTriaje = registro.estado === 'PENDIENTE' && registro.prioridad !== 'BAJA'
                      
                      tr(class=rowClass)
                        td
                          if registro.prioridad
                            case registro.prioridad
                              when 'ALTA'
                                span.badge.bg-danger(title='Urgente - atención inmediata')
                                  i.fas.fa-exclamation-triangle.me-1
                                  | ALTA
                              when 'MEDIA'
                                span.badge.bg-warning.text-dark MEDIA
                              when 'BAJA'
                                span.badge.bg-secondary BAJA
                          else
                            span.badge.bg-secondary N/A
                        
                        td
                          if registro.paciente && registro.paciente.usuario
                            strong= `${registro.paciente.usuario.nombre || ''} ${registro.paciente.usuario.apellido || ''}`
                            if registro.paciente.usuario.telefono
                              br
                              small.text-muted
                                i.fas.fa-phone.me-1
                                = registro.paciente.usuario.telefono
                          else
                            strong Paciente no disponible
                        
                        td
                          if registro.paciente && registro.paciente.usuario
                            code= registro.paciente.usuario.dni || 'Sin DNI'
                          else
                            small.text-muted N/A
                        
                        td
                          if registro.tipo_turno
                            small= registro.tipo_turno.nombre
                          else
                            small.text-muted Sin tipo
                        
                        td
                          if registro.tipo_estudio
                            small.text-muted 
                              i.fas.fa-flask.me-1
                              | #{registro.tipo_estudio.nombre}
                            br
                          if registro.especialidad
                            small.text-muted
                              i.fas.fa-user-md.me-1
                              | #{registro.especialidad.nombre}
                        
                        td
                          if tiempoEsperaMins > 0
                            if horas > 0 || minutos > 30
                              span.badge.bg-danger(title='Lleva mucho tiempo esperando') #{horas}h #{minutos}m
                            else
                              span.badge.bg-secondary #{horas}h #{minutos}m
                          else
                            span.badge.bg-light.text-dark 0h 0m
                        
                        td
                          if registro.estado
                            case registro.estado
                              when 'PENDIENTE'
                                span.badge.bg-warning.text-dark(title='Esperando atención')
                                  i.fas.fa-clock.me-1
                                  | Pendiente
                              when 'ASIGNADO'
                                span.badge.bg-primary(title='Tiene turno asignado')
                                  i.fas.fa-calendar-check.me-1
                                  | Con Turno
                              when 'COMPLETADO'
                                span.badge.bg-success(title='Ya atendido')
                                  i.fas.fa-check.me-1
                                  | Completado
                              default
                                span.badge.bg-secondary= registro.estado
                          else
                            span.badge.bg-secondary Sin estado
                        
                        td
                          .btn-group.btn-group-sm(role='group')
                            if registro.id
                              a.btn.btn-outline-info(href=`/enfermero/lista-espera/${registro.id}` title='Ver detalles')
                                i.fas.fa-eye
                            if necesitaTriaje && registro.paciente_id
                              a.btn.btn-outline-success(href=`/enfermero/triaje/nuevo?paciente_id=${registro.paciente_id}` title='Realizar triaje')
                                i.fas.fa-stethoscope
                            if registro.estado === 'PENDIENTE' && registro.paciente && registro.paciente.usuario
                              - const nombreCompleto = `${registro.paciente.usuario.nombre || ''} ${registro.paciente.usuario.apellido || ''}`
                              button.btn.btn-outline-warning(onclick=`llamarPaciente('${registro.id}', '${nombreCompleto}')` title='Llamar paciente')
                                i.fas.fa-bell
            else
              .p-5.text-center.text-muted
                i.fas.fa-check-circle.fa-4x.mb-3.text-success
                h5 No hay pacientes en espera
                p.mb-0 
                  if enfermeroInfo && enfermeroInfo.sector
                    | La lista de espera del sector 
                    strong #{enfermeroInfo.sector}
                    |  está vacía
                  else
                    | La lista de espera está vacía
                a.btn.btn-outline-primary.mt-3(href='/enfermero/triaje/nuevo')
                  i.fas.fa-plus.me-2
                  | Registrar nuevo paciente

    // Modal para llamar siguiente
    #modalLlamarSiguiente.modal.fade(tabindex='-1')
      .modal-dialog
        .modal-content
          .modal-header.bg-success.text-white
            h5.modal-title
              i.fas.fa-bell.me-2
              | Llamar Siguiente Paciente
            button.btn-close.btn-close-white(data-bs-dismiss='modal')
          .modal-body
            #contenido-siguiente
              .text-center
                .spinner-border.text-primary(role='status')
                  span.visually-hidden Buscando siguiente paciente...

    // Modal para llamar paciente específico
    #modalLlamarPaciente.modal.fade(tabindex='-1')
      .modal-dialog
        .modal-content
          .modal-header.bg-primary.text-white
            h5.modal-title
              i.fas.fa-user.me-2
              | Llamar Paciente
            button.btn-close.btn-close-white(data-bs-dismiss='modal')
          .modal-body.text-center
            h4#nombre-paciente-llamar.mb-3
            p Por favor, llame al paciente en sala de espera.
            .alert.alert-warning.mt-3
              i.fas.fa-exclamation-triangle.me-2
              | Recuerde realizar el triaje antes de derivar al médico
            .mt-4
              a.btn.btn-success.me-2(href='' id='btn-realizar-triaje')
                i.fas.fa-stethoscope.me-2
                | Realizar Triaje
              button.btn.btn-outline-secondary(data-bs-dismiss='modal')
                i.fas.fa-times.me-2
                | Cerrar

    // Modal pacientes con mayor tiempo de espera
    #modalMayorEspera.modal.fade(tabindex='-1')
      .modal-dialog.modal-lg
        .modal-content
          .modal-header.bg-warning
            h5.modal-title
              i.fas.fa-clock.me-2
              | Pacientes con Mayor Tiempo de Espera
            button.btn-close(data-bs-dismiss='modal')
          .modal-body
            #contenido-mayor-espera
              .text-center
                .spinner-border.text-primary(role='status')
                  span.visually-hidden Cargando...

block scripts
  script.
    // Variable global para el paciente seleccionado
    let pacienteSeleccionadoId = null;
    let pacienteSeleccionadoNombre = '';
    
    // Obtener sector_id del enfermero
    const sectorId = #{enfermeroInfo && enfermeroInfo.sector_id ? enfermeroInfo.sector_id : 'null'};
    
    // Llamar al siguiente paciente (del sector)
    function llamarSiguiente() {
      if (!sectorId) {
        alert('No tiene un sector asignado. Contacte al administrador.');
        return;
      }
      
      const url = `/enfermero/lista-espera/siguiente?sector_id=${sectorId}`;
      
      fetch(url)
        .then(response => response.json())
        .then(data => {
          const contenido = document.getElementById('contenido-siguiente');
          if (data.success) {
            contenido.innerHTML = `
              <div class="text-center">
                <h4 class="mb-3">${data.paciente.nombre}</h4>
                <div class="alert alert-info">
                  <p class="mb-1"><strong>DNI:</strong> ${data.paciente.dni}</p>
                  <p class="mb-1"><strong>Tipo:</strong> ${data.registro.tipo_turno}</p>
                  <p class="mb-1"><strong>Prioridad:</strong> ${data.registro.prioridad}</p>
                  <p class="mb-0"><strong>Tiempo espera:</strong> ${data.registro.tiempo_espera_minutos} minutos</p>
                </div>
                <div class="mt-3">
                  <button class="btn btn-primary me-2" onclick="realizarTriaje(${data.paciente.id})">
                    <i class="fas fa-stethoscope me-2"></i>Realizar Triaje
                  </button>
                  <button class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cerrar
                  </button>
                </div>
              </div>
            `;
          } else {
            contenido.innerHTML = `
              <div class="text-center">
                <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                <h5>${data.message}</h5>
                <p>No hay pacientes pendientes en este momento.</p>
              </div>
            `;
          }
        })
        .catch(error => {
          document.getElementById('contenido-siguiente').innerHTML = `
            <div class="alert alert-danger">
              <i class="fas fa-exclamation-triangle me-2"></i>
              Error al obtener siguiente paciente
            </div>
          `;
        });
      
      const modal = new bootstrap.Modal(document.getElementById('modalLlamarSiguiente'));
      modal.show();
    }
    
    // Llamar paciente específico
    function llamarPaciente(id, nombre) {
      pacienteSeleccionadoId = id;
      pacienteSeleccionadoNombre = nombre;
      
      document.getElementById('nombre-paciente-llamar').textContent = nombre;
      
      // Configurar el enlace para triaje con el paciente específico
      const btnTriaje = document.getElementById('btn-realizar-triaje');
      if (btnTriaje && pacienteSeleccionadoId) {
        btnTriaje.href = `/enfermero/triaje/nuevo?paciente_id=${pacienteSeleccionadoId}`;
      }
      
      const modal = new bootstrap.Modal(document.getElementById('modalLlamarPaciente'));
      modal.show();
    }
    
    // Realizar triaje directamente
    function realizarTriaje(pacienteId) {
      window.location.href = `/enfermero/triaje/nuevo?paciente_id=${pacienteId}`;
    }
    
    // Buscar paciente (solo en este sector)
    function buscarPaciente() {
      const busqueda = document.getElementById('buscar-paciente').value.trim();
      if (busqueda.length < 2) {
        alert('Ingrese al menos 2 caracteres para buscar');
        return;
      }
      
      if (!sectorId) {
        alert('No tiene un sector asignado. Contacte al administrador.');
        return;
      }
      
      const url = `/enfermero/lista-espera/buscar?busqueda=${encodeURIComponent(busqueda)}&sector_id=${sectorId}`;
      
      fetch(url)
        .then(response => response.json())
        .then(data => {
          if (data.success && data.resultados.length > 0) {
            // Redirigir al primero o mostrar lista
            if (data.resultados.length === 1) {
              window.location.href = `/enfermero/lista-espera/${data.resultados[0].id}`;
            } else {
              // Mostrar modal con resultados
              alert(`Encontrados ${data.resultados.length} pacientes. Use los filtros para verlos.`);
            }
          } else {
            alert('No se encontraron pacientes con ese criterio');
          }
        })
        .catch(error => {
          alert('Error en la búsqueda');
        });
    }
    
    // Ver pacientes con mayor tiempo de espera
    function verMayorEspera() {
      if (!sectorId) {
        alert('No tiene un sector asignado. Contacte al administrador.');
        return;
      }
      
      const url = `/enfermero/lista-espera/mayor-tiempo-espera?sector_id=${sectorId}`;
      
      fetch(url)
        .then(response => response.json())
        .then(data => {
          const contenido = document.getElementById('contenido-mayor-espera');
          if (data.success && data.registros.length > 0) {
            let html = '<table class="table table-sm">';
            html += '<thead><tr><th>Paciente</th><th>DNI</th><th>Tiempo Espera</th><th>Prioridad</th><th></th></tr></thead>';
            html += '<tbody>';
            data.registros.forEach(reg => {
              html += `
                <tr>
                  <td>${reg.paciente}</td>
                  <td>${reg.dni}</td>
                  <td><span class="badge bg-danger">${reg.tiempo_espera}</span></td>
                  <td>${reg.prioridad}</td>
                  <td>
                    <button class="btn btn-sm btn-outline-primary" onclick="window.location.href='/enfermero/lista-espera/${reg.id}'">
                      <i class="fas fa-eye"></i>
                    </button>
                  </td>
                </tr>
              `;
            });
            html += '</tbody></table>';
            contenido.innerHTML = html;
          } else {
            contenido.innerHTML = `
              <div class="text-center">
                <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                <h5>No hay pacientes con mucho tiempo de espera</h5>
              </div>
            `;
          }
        })
        .catch(error => {
          contenido.innerHTML = `
            <div class="alert alert-danger">
              <i class="fas fa-exclamation-triangle me-2"></i>
              Error al cargar datos
            </div>
          `;
        });
      
      const modal = new bootstrap.Modal(document.getElementById('modalMayorEspera'));
      modal.show();
    }
    
    // Limpiar filtros (mantener sector)
    function limpiarFiltros() {
      if (sectorId) {
        window.location.href = `/enfermero/lista-espera?sector_id=${sectorId}`;
      } else {
        window.location.href = `/enfermero/lista-espera`;
      }
    }
    
    // Auto-focus en búsqueda
    document.addEventListener('DOMContentLoaded', function() {
      const inputBusqueda = document.getElementById('buscar-paciente');
      if (inputBusqueda) {
        inputBusqueda.addEventListener('keypress', function(e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            buscarPaciente();
          }
        });
      }
      
      // Mostrar mensaje si no hay sector asignado
      if (!sectorId) {
        const alertDiv = document.createElement('div');
        alertDiv.className = 'alert alert-warning mt-3';
        alertDiv.innerHTML = `
          <i class="fas fa-exclamation-triangle me-2"></i>
          <strong>No tiene un sector asignado.</strong> Contacte al administrador para que le asigne un sector de trabajo.
        `;
        document.querySelector('.container-fluid').prepend(alertDiv);
      }
    });