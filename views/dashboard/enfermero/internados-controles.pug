extends ../../layouts/enfermero-layout

block content
  .container-fluid
    // Header
    .row.mb-4
      .col-12
        nav(aria-label="breadcrumb")
          ol.breadcrumb
            li.breadcrumb-item
              a(href="/enfermero") Dashboard
            li.breadcrumb-item
              a(href="/enfermero/internados") Internados
            li.breadcrumb-item.active Controles

    .row.mb-4
      .col-12
        .d-flex.justify-content-between.align-items-center
          div
            h2.mb-1
              i.fas.fa-heartbeat.me-2
              | Controles de Enfermería
            if internacion && internacion.paciente && internacion.paciente.usuario
              p.text-muted.mb-0= `${internacion.paciente.usuario.nombre} ${internacion.paciente.usuario.apellido} - DNI: ${internacion.paciente.usuario.dni}`
            hr.my-3
            .row.g-3.mb-3
              .col-md-3
                small.text-muted Total Controles
                h4.mb-0= controles.length
              .col-md-3
                small.text-muted Completados
                h4.mb-0.text-success= controles.filter(c => c.estado === 'COMPLETADO').length
              .col-md-3
                small.text-muted Pendientes
                h4.mb-0.text-warning= controles.filter(c => c.estado === 'PENDIENTE').length
              .col-md-3
                small.text-muted Solicitados
                h4.mb-0.text-secondary= controles.filter(c => c.estado === 'SOLICITADO').length
          div
            if internacion && internacion.id
              a.btn.btn-outline-secondary(href=`/enfermero/internados/${internacion.id}`)
                i.fas.fa-arrow-left.me-2
                | Volver a Internación
            else
              a.btn.btn-outline-secondary(href="/enfermero/internados")
                i.fas.fa-arrow-left.me-2
                | Volver a Internados

    // Tabla de controles
    .row
      .col-12
        .card.border-0.shadow-sm
          .card-header.bg-white
            h5.mb-0
              i.fas.fa-list.me-2
              | Listado de Controles
          .card-body.p-0
            if controles && controles.length > 0
              .table-responsive
                table.table.table-hover.mb-0
                  thead.table-light
                    tr
                      th Fecha
                      th Enfermero
                      th P.A.
                      th F.C.
                      th Temp.
                      th O2
                      th Peso/Altura
                      th Grupo Sang.
                      th Estado
                      th Acciones
                  tbody
                    each control in controles
                      tr
                        td
                          small= new Date(control.createdAt).toLocaleString('es-AR')
                        td
                          if control.evaluacion && control.evaluacion.enfermero && control.evaluacion.enfermero.usuario
                            small= `${control.evaluacion.enfermero.usuario.nombre} ${control.evaluacion.enfermero.usuario.apellido}`
                          else
                            small.text-muted No asignado
                        td
                          small= control.presion_arterial || 'N/A'
                        td
                          small= control.frecuencia_cardiaca ? `${control.frecuencia_cardiaca} lpm` : 'N/A'
                        td
                          if control.temperatura
                            small= `${control.temperatura}°C`
                          else
                            small.text-muted N/A
                        td
                          if control.nivel_oxigeno
                            small= `${control.nivel_oxigeno}%`
                          else
                            small.text-muted N/A
                        td
                          if control.peso && control.altura
                            small
                              = `${control.peso} kg / ${control.altura} cm`
                              br
                              - const imc = (control.peso / Math.pow(control.altura / 100, 2)).toFixed(1)
                              span.text-muted IMC: #{imc}
                          else
                            small.text-muted N/A
                        td
                          if control.grupo_sanguineo
                            span.badge.bg-danger= `${control.grupo_sanguineo} ${control.factor_rh || ''}`
                          else
                            small.text-muted N/A
                        td
                          case control.estado
                            when 'COMPLETADO'
                              span.badge.bg-success COMPLETADO
                            when 'PENDIENTE'
                              span.badge.bg-warning.text-dark PENDIENTE
                            when 'SOLICITADO'
                              span.badge.bg-secondary SOLICITADO
                            when 'CANCELADO'
                              span.badge.bg-danger CANCELADO
                            default
                              span.badge.bg-secondary N/A
                        td
                          .btn-group.btn-group-sm(role='group')
                            a.btn.btn-outline-info(href=`/enfermero/controles/${control.id}` title='Ver detalle')
                              i.fas.fa-eye
                            if control.estado === 'SOLICITADO' || control.estado === 'PENDIENTE'
                              a.btn.btn-outline-primary(href=`/enfermero/controles/${control.id}/editar` title='Editar')
                                i.fas.fa-edit
            else
              .p-5.text-center.text-muted
                i.fas.fa-inbox.fa-4x.mb-3
                h5 No hay controles registrados
                p.mb-0 El paciente aún no tiene controles de enfermería registrados

    
    
