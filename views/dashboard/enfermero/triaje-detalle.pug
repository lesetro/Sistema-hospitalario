extends ../../layouts/enfermero-layout

block content
  .container-fluid
    // Breadcrumb
    nav(aria-label="breadcrumb")
      ol.breadcrumb
        li.breadcrumb-item
          a(href="/enfermero") Dashboard
        li.breadcrumb-item
          a(href="/enfermero/triaje") Triaje
        li.breadcrumb-item.active Detalle

    .row.justify-content-center
      .col-lg-10
        .card.border-0.shadow-sm
          .card-header.d-flex.justify-content-between.align-items-center
            h4.mb-0
              i.fas.fa-heartbeat.me-2
              | Detalle de Triaje ##{evaluacion.id}
            div
              case evaluacion.nivel_triaje
                when 'Rojo'
                  span.badge.bg-danger.fs-5 ROJO - Emergencia
                when 'Amarillo'
                  span.badge.bg-warning.text-dark.fs-5 AMARILLO - Urgente
                when 'Verde'
                  span.badge.bg-success.fs-5 VERDE - No Urgente
                when 'Negro'
                  span.badge.bg-dark.fs-5 NEGRO - Expectante
          
          .card-body
            .row
              // Datos del paciente
              .col-md-6
                .card.mb-3
                  .card-header.bg-primary.text-white
                    h5.mb-0
                      i.fas.fa-user.me-2
                      | Datos del Paciente
                  .card-body
                    table.table.table-borderless.mb-0
                      tbody
                        tr
                          th(style="width: 40%") Nombre:
                          td= `${evaluacion.paciente.usuario.nombre} ${evaluacion.paciente.usuario.apellido}`
                        tr
                          th DNI:
                          td= evaluacion.paciente.usuario.dni
                        tr
                          th Sexo:
                          td= evaluacion.paciente.usuario.sexo
                        tr
                          th Teléfono:
                          td= evaluacion.paciente.usuario.telefono || 'No registrado'

              // Datos del triaje
              .col-md-6
                .card.mb-3
                  .card-header.bg-info.text-white
                    h5.mb-0
                      i.fas.fa-clipboard-check.me-2
                      | Datos del Triaje
                  .card-body
                    table.table.table-borderless.mb-0
                      tbody
                        tr
                          th(style="width: 40%") Fecha:
                          td= new Date(evaluacion.fecha).toLocaleString('es-AR')
                        if evaluacion.enfermero && evaluacion.enfermero.usuario
                          tr
                            th Enfermero:
                            td= `${evaluacion.enfermero.usuario.nombre} ${evaluacion.enfermero.usuario.apellido}`
                        else
                          tr
                            th Origen:
                            td Orden médica
                        tr
                          th Estado:
                          td
                            case evaluacion.tipo_egreso
                              when 'PENDIENTE_EVALUACION'
                                span.badge.bg-warning Pendiente
                              when 'DERIVACION_MEDICO'
                                span.badge.bg-primary Derivado a Médico
                              when 'DERIVACION_URGENCIA'
                                span.badge.bg-danger Derivado Urgencia
                              when 'PROCEDIMIENTO_COMPLETADO'
                                span.badge.bg-success Completado
                              default
                                span.badge.bg-secondary= evaluacion.tipo_egreso

            // Signos vitales
            .card.mb-3
              .card-header.bg-light
                h5.mb-0
                  i.fas.fa-heartbeat.me-2
                  | Signos Vitales
              .card-body
                p.mb-0= evaluacion.signos_vitales || 'No registrados'

            // Observaciones
            .card.mb-3
              .card-header.bg-light
                h5.mb-0
                  i.fas.fa-notes-medical.me-2
                  | Observaciones
              .card-body
                pre.mb-0(style="white-space: pre-wrap; font-family: inherit;")= evaluacion.observaciones || 'Sin observaciones'

            // Acciones
            .d-flex.justify-content-between.mt-4
              a.btn.btn-secondary(href="/enfermero/triaje")
                i.fas.fa-arrow-left.me-2
                | Volver al listado

              if evaluacion.tipo_egreso === 'PENDIENTE_EVALUACION'
                .btn-group
                  button.btn.btn-success(type="button" data-bs-toggle="modal" data-bs-target="#modalCompletar")
                    i.fas.fa-check.me-2
                    | Completar
                  a.btn.btn-primary(href='/enfermero/evaluaciones')
                    i.fas.fa-user-md.me-2
                    | Derivar a Médico desde Evaluación Enfermería

    // Modal Completar
    .modal.fade#modalCompletar(tabindex="-1")
      .modal-dialog
        .modal-content
          .modal-header.bg-success.text-white
            h5.modal-title
              i.fas.fa-check.me-2
              | Completar Triaje
            button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal")
          .modal-body
            form#formCompletar
              .mb-3
                label.form-label Observaciones finales
                textarea.form-control(name="observaciones_finales" rows="4" placeholder="Ingrese observaciones finales...")
          .modal-footer
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
            button.btn.btn-success(type="button" onclick="completarTriaje()")
              i.fas.fa-check.me-2
              | Confirmar

    // Modal Derivar
    .modal.fade#modalDerivar(tabindex="-1")
      .modal-dialog
        .modal-content
          .modal-header.bg-primary.text-white
            h5.modal-title
              i.fas.fa-user-md.me-2
              | Derivar a Médico
            button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal")
          .modal-body
            form#formDerivar
              .mb-3
                label.form-label Motivo de derivación *
                textarea.form-control(name="motivo_derivacion" rows="3" required placeholder="Describa el motivo de la derivación...")
              .mb-3
                .form-check
                  input.form-check-input#checkUrgente(type="checkbox" name="urgente" value="true")
                  label.form-check-label(for="checkUrgente")
                    span.text-danger
                      i.fas.fa-exclamation-triangle.me-1
                      | Marcar como URGENTE
          .modal-footer
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
            button.btn.btn-primary(type="button" onclick="derivarMedico()")
              i.fas.fa-paper-plane.me-2
              | Derivar

block scripts
  script.
    const evaluacionId = #{evaluacion.id};

    async function completarTriaje() {
      const formData = new FormData(document.getElementById('formCompletar'));
      const data = Object.fromEntries(formData);

      try {
        const response = await fetch(`/enfermero/triaje/${evaluacionId}/completar`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await response.json();
        if (result.success) {
          alert('Triaje completado correctamente');
          window.location.href = '/enfermero/triaje';
        } else {
          alert(result.message || 'Error al completar');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error al procesar la solicitud');
      }
    }

    async function derivarMedico() {
      const formData = new FormData(document.getElementById('formDerivar'));
      const data = Object.fromEntries(formData);
      data.urgente = document.getElementById('checkUrgente').checked ? 'true' : 'false';

      if (!data.motivo_derivacion) {
        alert('Debe ingresar el motivo de derivación');
        return;
      }

      try {
        const response = await fetch(`/enfermero/triaje/${evaluacionId}/derivar`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await response.json();
        if (result.success) {
          alert('Paciente derivado correctamente');
          window.location.href = '/enfermero/triaje';
        } else {
          alert(result.message || 'Error al derivar');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error al procesar la solicitud');
      }
    }