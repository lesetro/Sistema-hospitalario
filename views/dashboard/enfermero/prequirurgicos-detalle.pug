extends ../../layouts/enfermero-layout

block content
  .container-fluid
    //- Header
    .row.mb-4
      .col-12
        .d-flex.justify-content-between.align-items-center
          div
            h2.mb-1
              i.fas.fa-notes-medical.me-2
              | Detalle de Preparación Pre-quirúrgica
            p.text-muted.mb-0 ID: #{procedimiento.id} - 
              if procedimiento.estado === 'Pendiente'
                span.badge.bg-warning Pendiente
              else
                span.badge.bg-success Completado
          div
            a.btn.btn-secondary(href='/enfermero/prequirurgicos')
              i.fas.fa-arrow-left.me-2
              | Volver a la lista

    //- Información principal
    .row
      .col-lg-8
        //- Tarjeta de información del procedimiento
        .card.border-0.shadow-sm.mb-4
          .card-header.bg-white
            h4.card-title.mb-0
              i.fas.fa-stethoscope.me-2
              | Procedimiento: #{procedimiento.nombre}
          .card-body
            if procedimiento.descripcion
              .mb-3
                strong Descripción:
                p.text-muted.mt-1 #{procedimiento.descripcion}
            
            .row
              .col-md-6.mb-3
                strong Estado:
                br
                if procedimiento.estado === 'Pendiente'
                  span.badge.bg-warning.fs-6
                    i.fas.fa-clock.me-1
                    | Pendiente
                else
                  span.badge.bg-success.fs-6
                    i.fas.fa-check-circle.me-1
                    | Completado
              
              .col-md-6.mb-3
                strong Fecha de creación:
                br
                span.text-muted #{new Date(procedimiento.createdAt).toLocaleDateString('es-AR')}

        //- Información del paciente
        .card.border-0.shadow-sm.mb-4
          .card-header.bg-white
            h4.card-title.mb-0
              i.fas.fa-user-injured.me-2
              | Información del Paciente
          .card-body
            if procedimiento.evaluacion_medica && procedimiento.evaluacion_medica.paciente
              - const paciente = procedimiento.evaluacion_medica.paciente.usuario
              .row
                .col-md-6.mb-3
                  strong Nombre:
                  br
                  span.text-muted #{paciente.nombre} #{paciente.apellido}
                
                .col-md-6.mb-3
                  strong DNI:
                  br
                  span.text-muted #{paciente.dni}
                
                .col-md-6.mb-3
                  strong Edad:
                  br
                  - const edad = Math.floor((new Date() - new Date(paciente.fecha_nacimiento)) / (1000 * 60 * 60 * 24 * 365))
                  span.text-muted #{edad} años
                
                .col-md-6.mb-3
                  strong Sexo:
                  br
                  span.text-muted #{paciente.sexo === 'M' ? 'Masculino' : 'Femenino'}
                
                if paciente.telefono
                  .col-md-6.mb-3
                    strong Teléfono:
                    br
                    span.text-muted #{paciente.telefono}

        //- Información del médico
        .card.border-0.shadow-sm.mb-4
          .card-header.bg-white
            h4.card-title.mb-0
              i.fas.fa-user-md.me-2
              | Médico Solicitante
          .card-body
            if procedimiento.evaluacion_medica && procedimiento.evaluacion_medica.medico
              - const medico = procedimiento.evaluacion_medica.medico.usuario
              p.mb-0
                strong Dr. #{medico.nombre} #{medico.apellido}

        //- Evaluación de enfermería (si existe)
        if procedimiento.evaluacion_enfermeria
          .card.border-0.shadow-sm.mb-4
            .card-header.bg-white
              h4.card-title.mb-0
                i.fas.fa-clipboard-check.me-2
                | Evaluación de Enfermería
            .card-body
              .row
                .col-md-6.mb-3
                  strong Fecha evaluación:
                  br
                  span.text-muted #{new Date(procedimiento.evaluacion_enfermeria.fecha).toLocaleDateString('es-AR')}
                
                if procedimiento.evaluacion_enfermeria.signos_vitales
                  .col-md-6.mb-3
                    strong Signos vitales:
                    br
                    span.text-muted #{procedimiento.evaluacion_enfermeria.signos_vitales}
                
                if procedimiento.evaluacion_enfermeria.observaciones
                  .col-12.mb-3
                    strong Observaciones:
                    br
                    span.text-muted #{procedimiento.evaluacion_enfermeria.observaciones}
                
                if procedimiento.evaluacion_enfermeria.enfermero
                  .col-md-6.mb-3
                    strong Enfermero/a:
                    br
                    span.text-muted #{procedimiento.evaluacion_enfermeria.enfermero.usuario.nombre} #{procedimiento.evaluacion_enfermeria.enfermero.usuario.apellido}

      //- Panel lateral - Acciones
      .col-lg-4
        //- Tarjeta de acciones
        .card.border-0.shadow-sm.mb-4
          .card-header.bg-white
            h4.card-title.mb-0
              i.fas.fa-cogs.me-2
              | Acciones
          .card-body
            if procedimiento.estado === 'Pendiente'
              //- Si está pendiente, mostrar botón Completar
              a.btn.btn-success.btn-lg.w-100.mb-3(href=`/enfermero/prequirurgicos/${procedimiento.id}/completar`)
                i.fas.fa-check-circle.me-2
                | Completar Preparación
            else
              //- Si está completado, mostrar información
              .alert.alert-success
                i.fas.fa-check-circle.me-2
                | Preparación completada
                br
                small.text-muted No requiere acciones adicionales
            
            //- Botón Reportar complicación (siempre visible)
            button.btn.btn-warning.w-100.mb-3(type='button', onclick=`registrarComplicacion(${procedimiento.id})`)
              i.fas.fa-exclamation-triangle.me-2
              | Reportar Complicación

        //- Intervención quirúrgica (si existe)
        if intervencion
          .card.border-0.shadow-sm.mb-4
            .card-header.bg-white
              h4.card-title.mb-0
                i.fas.fa-procedures.me-2
                | Intervención Quirúrgica
            .card-body
              p.mb-1
                strong Tipo:
                span.ms-2.text-muted #{intervencion.tipo_intervencion}
              
              if intervencion.fecha_programada
                p.mb-1
                  strong Fecha programada:
                  br
                  span.text-muted #{new Date(intervencion.fecha_programada).toLocaleDateString('es-AR')}
              
              if intervencion.quirofano
                p.mb-0
                  strong Quirófano:
                  span.ms-2.text-muted #{intervencion.quirofano}

        //- Información rápida
        .card.border-0.shadow-sm
          .card-header.bg-white
            h4.card-title.mb-0
              i.fas.fa-info-circle.me-2
              | Información Rápida
          .card-body
            ul.list-unstyled.mb-0
              li.mb-2
                i.fas.fa-id-badge.me-2.text-primary
                strong ID: 
                span #{procedimiento.id}
              
              li.mb-2
                i.fas.fa-calendar-alt.me-2.text-primary
                strong Creado: 
                span #{new Date(procedimiento.createdAt).toLocaleDateString('es-AR')}
              
              if procedimiento.updated_at
                li.mb-0
                  i.fas.fa-history.me-2.text-primary
                  strong Actualizado: 
                  span #{new Date(procedimiento.updated_at).toLocaleDateString('es-AR')}

    //- Modal para reportar complicación
    .modal.fade#modalComplicacion(tabindex='-1', aria-labelledby='modalComplicacionLabel', aria-hidden='true')
      .modal-dialog
        .modal-content
          .modal-header.bg-warning
            h5.modal-title
              i.fas.fa-exclamation-triangle.me-2
              | Reportar Complicación
            button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Close')
          .modal-body
            form#form-complicacion
              input(type='hidden', id='complicacion-proc-id', value=procedimiento.id)
              
              .mb-3
                label.form-label(for='tipo-complicacion') Tipo de Complicación
                select.form-select#tipo-complicacion(required)
                  option(value='') Seleccionar
                  option(value='Paciente no cumplió ayuno') Paciente no cumplió ayuno
                  option(value='Estudios incompletos') Estudios incompletos
                  option(value='Consentimiento no firmado') Consentimiento no firmado
                  option(value='Condición médica nueva') Condición médica nueva detectada
                  option(value='Alergia no documentada') Alergia no documentada
                  option(value='Otro') Otro
              
              .mb-3
                label.form-label(for='desc-complicacion') Descripción Detallada
                textarea.form-control#desc-complicacion(rows='4', required, placeholder='Describa la complicación...')
              
              .mb-3
                .form-check
                  input.form-check-input#requiere-suspension(type='checkbox')
                  label.form-check-label(for='requiere-suspension')
                    strong.text-danger ¿Requiere suspensión de la cirugía?
          
          .modal-footer
            button.btn.btn-secondary(type='button', data-bs-dismiss='modal') Cancelar
            button.btn.btn-danger(onclick='guardarComplicacion()') Reportar Complicación

block scripts
  script.
    //- Funciones para el modal de complicación
    function registrarComplicacion(procId) {
      console.log('Registrar complicación para:', procId);
      document.getElementById('complicacion-proc-id').value = procId;
      
      const modal = new bootstrap.Modal(document.getElementById('modalComplicacion'));
      modal.show();
    }

    async function guardarComplicacion() {
      const procId = document.getElementById('complicacion-proc-id').value;
      const tipo = document.getElementById('tipo-complicacion').value;
      const descripcion = document.getElementById('desc-complicacion').value;
      const requiereSuspension = document.getElementById('requiere-suspension').checked;
      
      if (!tipo || !descripcion) {
        alert('Complete todos los campos');
        return;
      }
      
      try {
        const response = await fetch(`/enfermero/prequirurgicos/${procId}/complicacion`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            tipo_complicacion: tipo,
            descripcion: descripcion,
            requiere_suspension: requiereSuspension
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          alert(result.message);
          
          // Cerrar modal
          const modal = bootstrap.Modal.getInstance(document.getElementById('modalComplicacion'));
          modal.hide();
          
          // Recargar página para ver cambios
          window.location.reload();
        } else {
          alert(result.message || 'Error al registrar');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error al guardar la complicación');
      }
    }

    //- Inicialización
    document.addEventListener('DOMContentLoaded', function() {
      console.log('Página de detalle cargada');
      
      //- Validación del formulario de complicación
      const formComplicacion = document.getElementById('form-complicacion');
      if (formComplicacion) {
        formComplicacion.addEventListener('submit', function(e) {
          e.preventDefault();
          guardarComplicacion();
        });
      }
    });