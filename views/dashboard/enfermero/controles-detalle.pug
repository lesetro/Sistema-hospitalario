extends ../../layouts/enfermero-layout

block content
 
  - const pacienteData = control.evaluacion?.paciente || control.paciente
  
  .container-fluid
    nav(aria-label="breadcrumb")
      ol.breadcrumb
        li.breadcrumb-item
          a(href="/enfermero") Dashboard
        li.breadcrumb-item
          a(href="/enfermero/controles") Controles
        li.breadcrumb-item.active Detalle

    .row.justify-content-center
      .col-lg-10
        .card.border-0.shadow-sm
          .card-header.bg-primary.text-white
            h4.mb-0
              i.fas.fa-clipboard-list.me-2
              | Control de Enfermería ##{control.id}
          
          .card-body
            // Datos del paciente
            .row.mb-4
              .col-md-6
                .card.h-100
                  .card-header.bg-light
                    h5.mb-0
                      i.fas.fa-user.me-2
                      | Paciente
                  .card-body
                    table.table.table-borderless.mb-0
                      tr
                        th Nombre:
                        
                        td= `${pacienteData.usuario.nombre} ${pacienteData.usuario.apellido}`
                      tr
                        th DNI:
                        
                        td= pacienteData.usuario.dni
                      tr
                        th Sexo:
                       
                        td= pacienteData.usuario.sexo
              
              .col-md-6
                .card.h-100
                  .card-header.bg-light
                    h5.mb-0
                      i.fas.fa-info-circle.me-2
                      | Información del Control
                  .card-body
                    table.table.table-borderless.mb-0
                      tr
                        th Fecha:
                        td= new Date(control.createdAt).toLocaleString('es-AR')
                      tr
                        th Enfermero:
                        td
                          if control.evaluacion && control.evaluacion.enfermero && control.evaluacion.enfermero.usuario
                            = `${control.evaluacion.enfermero.usuario.nombre} ${control.evaluacion.enfermero.usuario.apellido}`
                          else
                            span.text-muted No asignado (se completará al ejecutarse)
                      tr
                        th Grupo Sanguíneo:
                        td
                          if control.grupo_sanguineo
                            span.badge.bg-danger= `${control.grupo_sanguineo} ${control.factor_rh || ''}`
                          else
                            span.text-muted No registrado

            // Alergias
            if control.alergias
              .alert.alert-warning.mb-4
                h5.alert-heading
                  i.fas.fa-exclamation-triangle.me-2
                  | Alergias
                p.mb-0= control.alergias

            // Medidas corporales
            .row.mb-4
              .col-md-4
                .card.text-center.h-100
                  .card-body
                    i.fas.fa-weight.fa-2x.text-primary.mb-2
                    h5 Peso
                    h3= control.peso ? `${control.peso} kg` : 'N/A'
              .col-md-4
                .card.text-center.h-100
                  .card-body
                    i.fas.fa-ruler-vertical.fa-2x.text-primary.mb-2
                    h5 Altura
                    h3= control.altura ? `${control.altura} cm` : 'N/A'
              .col-md-4
                .card.text-center.h-100
                  .card-body
                    i.fas.fa-calculator.fa-2x.text-primary.mb-2
                    h5 IMC
                    if control.peso && control.altura
                      - const imc = (control.peso / Math.pow(control.altura / 100, 2)).toFixed(1)
                      h3= imc
                    else
                      h3 N/A

            // Signos vitales
            .card.mb-4
              .card-header.bg-danger.text-white
                h5.mb-0
                  i.fas.fa-heartbeat.me-2
                  | Signos Vitales
              .card-body
                .row.text-center
                  .col-md-3
                    h6 Presión Arterial
                    h4= control.presion_arterial || 'N/A'
                  .col-md-3
                    h6 Frec. Cardíaca
                    h4= control.frecuencia_cardiaca ? `${control.frecuencia_cardiaca} lpm` : 'N/A'
                  .col-md-3
                    h6 Temperatura
                    h4= control.temperatura ? `${control.temperatura}°C` : 'N/A'
                  .col-md-3
                    h6 Sat. Oxígeno
                    h4= control.nivel_oxigeno ? `${control.nivel_oxigeno}%` : 'N/A'

            // Antecedentes
            .row.mb-4
              .col-md-6
                .card.h-100
                  .card-header.bg-light
                    h6.mb-0 Antecedentes Personales
                  .card-body
                    p.mb-0= control.antecedentes_personales || 'No registrados'
              .col-md-6
                .card.h-100
                  .card-header.bg-light
                    h6.mb-0 Antecedentes Familiares
                  .card-body
                    p.mb-0= control.antecedentes_familiares || 'No registrados'

            // Laboratorio - COMPLETO
            .card.mb-4
              .card-header.bg-info.text-white
                h5.mb-0
                  i.fas.fa-flask.me-2
                  | Valores de Laboratorio
              .card-body
                // Hemograma
                .mb-4
                  h6.border-bottom.pb-2
                    i.fas.fa-droplet.me-2
                    strong Hemograma
                  .row
                    .col-md-3
                      p
                        strong Hemoglobina (Hb):
                        br
                        code= control.nivel_hb || 'N/A'
                    .col-md-3
                      p
                        strong Hematocrito (Hct):
                        br
                        code= control.nivel_hct || 'N/A'
                    .col-md-3
                      p
                        strong Leucocitos:
                        br
                        code= control.nivel_leucocitos || 'N/A'
                    .col-md-3
                      p
                        strong Plaquetas:
                        br
                        code= control.nivel_plaquetas || 'N/A'

                // Metabolismo
                .mb-4
                  h6.border-bottom.pb-2
                    i.fas.fa-bolt.me-2
                    strong Metabolismo y Glucosa
                  .row
                    .col-md-3
                      p
                        strong Glucosa:
                        br
                        code= control.nivel_glucosa || 'N/A'
                    .col-md-3
                      p
                        strong Colesterol:
                        br
                        code= control.nivel_colesterol || 'N/A'
                    .col-md-3
                      p
                        strong Triglicéridos:
                        br
                        code= control.nivel_trigliceridos || 'N/A'
                    .col-md-3
                      p
                        strong Ácido Úrico:
                        br
                        code= control.nivel_acido_urico || 'N/A'

                // Función Renal
                .mb-4
                  h6.border-bottom.pb-2
                    i.fas.fa-kidney.me-2
                    strong Función Renal
                  .row
                    .col-md-4
                      p
                        strong Creatinina:
                        br
                        code= control.nivel_creatinina || 'N/A'
                    .col-md-4
                      p
                        strong Urea:
                        br
                        code= control.nivel_urea || 'N/A'

                // Proteínas
                .mb-0
                  h6.border-bottom.pb-2
                    i.fas.fa-dna.me-2
                    strong Proteínas y Enzimas
                  .row
                    .col-md-3
                      p
                        strong Proteínas Totales:
                        br
                        code= control.nivel_proteinas || 'N/A'
                    .col-md-3
                      p
                        strong Albúmina:
                        br
                        code= control.nivel_albumina || 'N/A'
                    .col-md-3
                      p
                        strong Globulina:
                        br
                        code= control.nivel_globulina || 'N/A'
                    .col-md-3
                      p
                        strong Fosfatasa Alcalina:
                        br
                        code= control.nivel_fosfatasa || 'N/A'

            // Botones
            .d-flex.justify-content-between
              a.btn.btn-secondary(href="/enfermero/controles")
                i.fas.fa-arrow-left.me-2
                | Volver
              a.btn.btn-primary(href=`/enfermero/controles/${control.id}/editar`)
                i.fas.fa-edit.me-2
                | Editar