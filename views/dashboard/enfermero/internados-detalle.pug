extends ../../layouts/enfermero-layout

block content
  .container-fluid.p-4
    // Header
    .row.mb-4
      .col-12
        .d-flex.justify-content-between.align-items-center
          div
            h2.mb-1
              i.fas.fa-bed.me-2
              | Detalle de Internación
            p.text-muted.mb-0 Información completa del paciente internado
          div
            a.btn.btn-outline-secondary(href='/enfermero/internados')
              i.fas.fa-arrow-left.me-2
              | Volver

    .row
      // Información del paciente
      .col-lg-8
        .card.border-0.shadow-sm.mb-4
          .card-header.bg-white
            h5.mb-0
              i.fas.fa-user.me-2
              | Información del Paciente
          .card-body
            .row
              .col-md-6.mb-3
                strong
                  i.fas.fa-id-card.me-2
                  | Nombre Completo:
                p.mb-0= internacion.paciente.usuario.nombre + ' ' + internacion.paciente.usuario.apellido
              
              .col-md-6.mb-3
                strong
                  i.fas.fa-hashtag.me-2
                  | DNI:
                p.mb-0= internacion.paciente.usuario.dni
              
              .col-md-6.mb-3
                strong
                  i.fas.fa-calendar.me-2
                  | Fecha de Nacimiento:
                p.mb-0= new Date(internacion.paciente.usuario.fecha_nacimiento).toLocaleDateString('es-AR')
              
              .col-md-6.mb-3
                strong
                  i.fas.fa-venus-mars.me-2
                  | Sexo:
                p.mb-0= internacion.paciente.usuario.sexo
              
              .col-md-6.mb-3
                strong
                  i.fas.fa-phone.me-2
                  | Teléfono:
                p.mb-0= internacion.paciente.usuario.telefono || 'No registrado'
              
              .col-md-6.mb-3
                strong
                  i.fas.fa-user-md.me-2
                  | Médico a Cargo:
                p.mb-0= internacion.medico ? `Dr. ${internacion.medico.usuario.nombre} ${internacion.medico.usuario.apellido}` : 'No asignado'

        // Datos de la internación
        .card.border-0.shadow-sm.mb-4
          .card-header.bg-white.d-flex.justify-content-between.align-items-center
            h5.mb-0
              i.fas.fa-hospital.me-2
              | Datos de la Internación
            //  BOTÓN PARA VER ÓRDENES MÉDICAS
            a.btn.btn-primary.btn-sm(href=`/enfermero/internados/paciente/${internacion.paciente_id}/ordenes`)
              i.fas.fa-clipboard-list.me-2
              | Ver Órdenes Médicas
          
          .card-body
            .row
              .col-md-6.mb-3
                strong
                  i.fas.fa-bed.me-2
                  | Ubicación:
                p.mb-0 Sector #{internacion.cama.habitacion.sector.nombre} - Hab. #{internacion.cama.habitacion.numero} - Cama #{internacion.cama.numero}
              
              .col-md-6.mb-3
                strong
                  i.fas.fa-calendar-plus.me-2
                  | Fecha de Ingreso:
                p.mb-0= new Date(internacion.fecha_inicio).toLocaleString('es-AR')
              
              .col-md-6.mb-3
                strong
                  i.fas.fa-heartbeat.me-2
                  | Estado del Paciente:
                if internacion.estado_paciente === 'Critico'
                  span.badge.bg-danger.p-2 Crítico
                else if internacion.estado_paciente === 'Grave'
                  span.badge.bg-warning.text-dark.p-2 Grave
                else if internacion.estado_paciente === 'Estable'
                  span.badge.bg-success.p-2 Estable
                else
                  span.badge.bg-secondary.p-2= internacion.estado_paciente
              
              .col-md-6.mb-3
                strong
                  i.fas.fa-notes-medical.me-2
                  | Motivo:
                p.mb-0= internacion.motivo || 'No especificado'
              
              if internacion.tipo_internacion
                .col-12.mb-3
                  strong
                    i.fas.fa-tag.me-2
                    | Tipo de Internación:
                  p.mb-0= internacion.tipo_internacion.nombre

        // Botones de acción
        .card.border-0.shadow-sm.mb-4
          .card-header.bg-white
            h5.mb-0
              i.fas.fa-tasks.me-2
              | Acciones
          .card-body
            .row.g-3
              .col-md-6
                button.btn.btn-success.w-100(
                  type="button"
                  data-bs-toggle="modal"
                  data-bs-target="#modalRegistrarEvolucion"
                )
                  i.fas.fa-notes-medical.me-2
                  | Registrar Evolución
              
              .col-md-6
                button.btn.btn-warning.w-100(
                  type="button"
                  data-bs-toggle="modal"
                  data-bs-target="#modalActualizarEstado"
                )
                  i.fas.fa-heartbeat.me-2
                  | Actualizar Estado

      // Sidebar con información adicional
      .col-lg-4
        // Controles recientes
        .card.border-0.shadow-sm.mb-4
          .card-header.bg-white
            h5.mb-0
              i.fas.fa-chart-line.me-2
              | Controles Recientes
          .card-body
            if controles && controles.length > 0
              each control in controles.slice(0, 5)
                .mb-3.pb-3.border-bottom
                  small.text-muted= new Date(control.fecha_control).toLocaleString('es-AR')
                  p.mb-1
                    strong Presión:
                    |  #{control.presion_arterial || 'N/A'}
                  p.mb-1
                    strong Temp:
                    |  #{control.temperatura || 'N/A'}°C
                  p.mb-0
                    strong Saturación:
                    |  #{control.saturacion_oxigeno || 'N/A'}%
            else
              p.text-muted.text-center Sin controles registrados
            
            hr
            a.btn.btn-outline-primary.w-100(href=`/enfermero/internados/${internacion.id}/controles`)
              i.fas.fa-list.me-2
              | Ver Todos los Controles

        // Evoluciones recientes
        .card.border-0.shadow-sm
          .card-header.bg-white
            h5.mb-0
              i.fas.fa-file-medical.me-2
              | Evoluciones del Paciente
          .card-body
            if internacion.observaciones && internacion.observaciones.trim()
              pre.bg-light.p-3.rounded(style="white-space: pre-wrap; font-family: inherit; font-size: 0.9rem; max-height: 400px; overflow-y: auto;")= internacion.observaciones
            else
              p.text-muted.text-center Sin evoluciones registradas

  //  MODAL PARA VER ÓRDENES MÉDICAS
  #modalOrdenesMedicas.modal.fade(tabindex='-1')
    .modal-dialog.modal-lg
      .modal-content
        .modal-header.bg-primary.text-white
          h5.modal-title
            i.fas.fa-clipboard-list.me-2
            | Órdenes Médicas
          button.btn-close.btn-close-white(type='button' data-bs-dismiss='modal')
        
        .modal-body
          #contenido-ordenes-medicas
            .text-center.py-4
              .spinner-border.text-primary(role='status')
                span.visually-hidden Cargando...
        
        .modal-footer
          button.btn.btn-secondary(type='button' data-bs-dismiss='modal')
            i.fas.fa-times.me-2
            | Cerrar

  // Modal para registrar evolución
  #modalRegistrarEvolucion.modal.fade(tabindex='-1')
    .modal-dialog
      .modal-content
        form#form-registrar-evolucion(action=`/enfermero/internados/${internacion.id}/registrar-evolucion` method='POST')
          .modal-header.bg-success.text-white
            h5.modal-title
              i.fas.fa-notes-medical.me-2
              | Registrar Evolución
            button.btn-close.btn-close-white(type='button' data-bs-dismiss='modal')
          
          .modal-body
            .mb-3
              label.form-label Observaciones
              textarea.form-control(
                name='observaciones'
                rows='5'
                required
                placeholder='Evolución del paciente, cambios observados, procedimientos realizados...'
              )
          
          .modal-footer
            button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancelar
            button.btn.btn-success(type='submit')
              i.fas.fa-save.me-2
              | Guardar Evolución

  // Modal para actualizar estado
  #modalActualizarEstado.modal.fade(tabindex='-1')
    .modal-dialog
      .modal-content
        form#form-actualizar-estado(action=`/enfermero/internados/${internacion.id}/actualizar-estado` method='POST')
          .modal-header.bg-warning
            h5.modal-title
              i.fas.fa-heartbeat.me-2
              | Actualizar Estado del Paciente
            button.btn-close(type='button' data-bs-dismiss='modal')
          
          .modal-body
            .mb-3
              label.form-label Estado del Paciente
              select.form-select(name='estado_paciente' required)
                option(value='Estable' selected=internacion.estado_paciente === 'Estable') Estable
                option(value='Grave' selected=internacion.estado_paciente === 'Grave') Grave
                option(value='Critico' selected=internacion.estado_paciente === 'Critico') Crítico
                option(value='En recuperación' selected=internacion.estado_paciente === 'En recuperación') En recuperación
            
            .mb-3
              label.form-label Observaciones
              textarea.form-control(
                name='observaciones'
                rows='3'
                placeholder='Motivo del cambio de estado...'
              )
          
          .modal-footer
            button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancelar
            button.btn.btn-warning(type='submit')
              i.fas.fa-save.me-2
              | Actualizar Estado

block scripts
  script(src='/js/enfermero/internados.detalle.js')