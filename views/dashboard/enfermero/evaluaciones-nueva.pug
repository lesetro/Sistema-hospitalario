extends ../../layouts/enfermero-layout

block content
  .container-fluid
    // Breadcrumb
    nav(aria-label="breadcrumb")
      ol.breadcrumb
        li.breadcrumb-item
          a(href="/enfermero") Dashboard
        li.breadcrumb-item
          a(href="/enfermero/evaluaciones") Evaluaciones
        li.breadcrumb-item.active Nueva Evaluación

    .row.justify-content-center
      .col-lg-10
        .card.border-0.shadow-sm
          .card-header.bg-primary.text-white
            h4.mb-0
              i.fas.fa-clipboard-check.me-2
              | Nueva Evaluación de Enfermería
          .card-body

            // Alerta informativa
            .alert.alert-info.mb-4
              i.fas.fa-info-circle.me-2
              | Esta evaluación es para pacientes que YA están en el sistema (internados, en espera, post-consulta).
              | Si el paciente acaba de llegar, use
              a(href="/enfermero/triaje/nuevo") Triaje
              | .

            // Búsqueda de paciente
            .card.bg-light.mb-4
              .card-body
                h5.card-title
                  i.fas.fa-search.me-2
                  | Buscar Paciente
                .input-group
                  input.form-control#input-dni(
                    type="text"
                    placeholder="Ingrese DNI del paciente"
                    maxlength="8"
                  )
                  button.btn.btn-primary(type="button" onclick="buscarPaciente()")
                    i.fas.fa-search.me-2
                    | Buscar

            // Información del paciente
            #info-paciente.alert.alert-success(style="display:none")
              h5.alert-heading
                i.fas.fa-user.me-2
                span#paciente-nombre
              p.mb-0
                strong DNI:
                span#paciente-dni
                |  |
                strong Edad:
                span#paciente-edad
                |  |
                strong Sexo:
                span#paciente-sexo

            // Formulario de evaluación
            form#form-evaluacion(style="display:none")
              input(type="hidden" id="paciente-id" name="paciente_id")

              // Tipo de evaluación
              .mb-4
                label.form-label.fw-bold
                  i.fas.fa-list.me-2
                  | Tipo de Evaluación *
                select.form-select#tipo-evaluacion(
                  name="tipo_evaluacion"
                  required
                  onchange="mostrarCamposTipo()"
                )
                  option(value="") Seleccione...
                  option(value="control") Control de Signos Vitales
                  option(value="procedimiento") Procedimiento de Enfermería
                  option(value="prequirurgico") Preparación Prequirúrgica
                  option(value="seguimiento") Seguimiento Post-Consulta

              // Signos Vitales
              .card.mb-4#seccion-signos
                .card-header.bg-light
                  h5.mb-0
                    i.fas.fa-heartbeat.me-2
                    | Signos Vitales
                .card-body
                  .row.g-3

                    .col-md-4
                      label.form-label Presión Arterial
                      .input-group
                        input.form-control(
                          type="text"
                          name="presion_arterial"
                          placeholder="120/80"
                          pattern="\\d{2,3}/\\d{2,3}"
                          title="Formato: 120/80"
                        )
                        span.input-group-text mmHg
                      small.text-muted Normal: 90/60 - 140/90

                    .col-md-4
                      label.form-label Frecuencia Cardíaca
                      .input-group
                        input.form-control(
                          type="number"
                          name="frecuencia_cardiaca"
                          placeholder="70"
                          min="30"
                          max="220"
                          title="Entre 30 y 220 lpm"
                        )
                        span.input-group-text lpm
                      small.text-muted Normal: 60-100 lpm

                    .col-md-4
                      label.form-label Temperatura
                      .input-group
                        input.form-control(
                          type="number"
                          step="0.1"
                          name="temperatura"
                          placeholder="36.5"
                          min="35"
                          max="42"
                          title="Entre 35°C y 42°C"
                        )
                        span.input-group-text °C
                      small.text-muted Normal: 36-37.5°C

                    .col-md-6
                      label.form-label Saturación de Oxígeno
                      .input-group
                        input.form-control(
                          type="number"
                          name="saturacion_oxigeno"
                          placeholder="98"
                          min="70"
                          max="100"
                          title="Entre 70% y 100%"
                        )
                        span.input-group-text %
                      small.text-muted Normal: >95%

                    .col-md-6
                      label.form-label Frecuencia Respiratoria
                      .input-group
                        input.form-control(
                          type="number"
                          name="frecuencia_respiratoria"
                          placeholder="16"
                          min="8"
                          max="40"
                          title="Entre 8 y 40 rpm"
                        )
                        span.input-group-text rpm
                      small.text-muted Normal: 12-20 rpm

              // Observaciones
              .mb-4
                label.form-label.fw-bold
                  i.fas.fa-notes-medical.me-2
                  | Observaciones
                textarea.form-control(
                  name="observaciones"
                  rows="4"
                  placeholder="Detalles de la evaluación..."
                )

              // Estado
              .mb-4
                label.form-label.fw-bold
                  i.fas.fa-flag.me-2
                  | Estado de la Evaluación
                select.form-select(name="tipo_egreso" onchange="mostrarSecciones()")
                  option(value="PENDIENTE_EVALUACION") Pendiente (requiere seguimiento)
                  option(value="PROCEDIMIENTO_COMPLETADO") Completado (solicitar alta)
                  option(value="DERIVACION_MEDICO") Derivar a Médico
                  option(value="DERIVACION_URGENCIA") Derivar a Urgencias
                  option(value="DERIVACION_CIRUGIA") Derivar a CIRUGIA

              // Sección para asignar turno
              #seccion-turno.mb-4(style="display:none")
                .card
                  .card-header.bg-info.text-white
                    h5.mb-0
                      i.fas.fa-calendar-plus.me-2
                      | Asignar Turno Médico
                  .card-body
                    .row.g-3
                      .col-md-6
                        label.form-label
                          i.fas.fa-user-md.me-1
                          | Seleccionar Médico *
                        select.form-select#select-medico(name="medico_id")
                          option(value="") Seleccione un médico...
                        small.form-text.text-muted Solo médicos del sector Urgencias

                      .col-md-6
                        label.form-label
                          i.fas.fa-calendar.me-1
                          | Fecha del Turno *
                        input.form-control#fecha-turno(
                          type="date"
                          name="fecha_turno"
                          min=new Date().toISOString().split('T')[0]
                        )

                    .mt-3#seccion-horarios(style="display:none")
                      label.form-label
                        i.fas.fa-clock.me-1
                        | Horarios Disponibles *
                      .row.g-2#lista-horarios
                      small.form-text.text-muted Seleccione un horario disponible

                    .alert.alert-info.mt-3#mensaje-horarios(style="display:none")
                      i.fas.fa-spinner.fa-spin.me-2
                      span#texto-mensaje

              // Botones
              .d-flex.justify-content-between
                a.btn.btn-secondary(href="/enfermero/evaluaciones")
                  i.fas.fa-arrow-left.me-2
                  | Cancelar
                button.btn.btn-primary.btn-lg(type="submit")
                  i.fas.fa-save.me-2
                  | Guardar Evaluación

block scripts
  script(src="/js/enfermero/evaluacion-nueva.js")
