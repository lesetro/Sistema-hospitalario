    // ========================================
    // FUNCIONES DE BÚSQUEDA Y MENSAJERÍA
    // ========================================

    function setupBuscadorUsuarios() {
      const input = document.getElementById('buscarUsuario');
      input.addEventListener('input', debounce(buscarUsuarios, 300));

      // Enviar formulario
      document.getElementById('formNuevoMensaje').addEventListener('submit', enviarMensaje);
    }

    async function buscarUsuarios() {
      const termino = document.getElementById('buscarUsuario').value.trim();

      if (termino.length < 2) {
        document.getElementById('resultadosBusqueda').classList.add('d-none');
        return;
      }

      try {
        const response = await fetch(`/medico/comunicaciones/api/usuarios/buscar?search=${encodeURIComponent(termino)}`);
        const data = await response.json();

        if (data.success && data.data.length > 0) {
          const lista = document.getElementById('listaBusqueda');
          lista.innerHTML = data.data.map(usuario => `
            <button class="list-group-item list-group-item-action text-start" 
                    type="button"
                    onclick="seleccionarUsuario(${usuario.id}, '${usuario.nombre} ${usuario.apellido}', '${usuario.email}')">
              <strong>${usuario.nombre} ${usuario.apellido}</strong>
              <br>
              <small class="text-muted">${usuario.email} | DNI: ${usuario.dni}</small>
            </button>
          `).join('');

          document.getElementById('resultadosBusqueda').classList.remove('d-none');
        } else {
          document.getElementById('resultadosBusqueda').classList.add('d-none');
        }
      } catch (error) {
        console.error('Error en búsqueda:', error);
      }
    }

    function seleccionarUsuario(id, nombre, email) {
      usuarioSeleccionado = { id, nombre, email };
      document.getElementById('buscarUsuario').value = nombre;
      document.getElementById('resultadosBusqueda').classList.add('d-none');
      document.getElementById('usuarioSeleccionado').classList.remove('d-none');
      document.getElementById('usuarioSeleccionadoNombre').textContent = `${nombre} (${email})`;
    }

    function deseleccionarUsuario() {
      usuarioSeleccionado = null;
      document.getElementById('buscarUsuario').value = '';
      document.getElementById('usuarioSeleccionado').classList.add('d-none');
    }

    function limpiarBusqueda() {
      document.getElementById('buscarUsuario').value = '';
      document.getElementById('resultadosBusqueda').classList.add('d-none');
    }

    async function enviarMensaje(e) {
      e.preventDefault();

      if (!usuarioSeleccionado) {
        mostrarAlerta('error', 'Selecciona un destinatario');
        return;
      }

      const mensaje = document.getElementById('mensajeNuevo').value.trim();
      if (!mensaje) {
        mostrarAlerta('error', 'El mensaje no puede estar vacío');
        return;
      }

      try {
        const response = await fetch('/medico/comunicaciones/api/notificaciones', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            usuario_id: usuarioSeleccionado.id,
            mensaje: mensaje
          })
        });

        const data = await response.json();

        if (data.success) {
          mostrarAlerta('success', 'Mensaje enviado correctamente');
          document.getElementById('formNuevoMensaje').reset();
          deseleccionarUsuario();
          bootstrap.Modal.getInstance(document.getElementById('modalNuevoMensaje')).hide();
          
          // Actualizar bandeja de salida y estadísticas
          cargarEstadisticas();
          if (vistaActual === 'enviados') {
            cargarMensajesEnviados();
          }
          // Actualizar conversaciones
          cargarConversaciones();
        } else {
          mostrarAlerta('error', data.message || 'Error al enviar mensaje');
        }
      } catch (error) {
        console.error('Error:', error);
        mostrarAlerta('error', 'Error al enviar mensaje');
      }
    }

    function responderMensaje(usuarioId, nombre) {
      seleccionarUsuario(usuarioId, nombre, '');
      const modal = new bootstrap.Modal(document.getElementById('modalNuevoMensaje'));
      modal.show();
    }

    // ========================================
    // FUNCIONES DE CONVERSACIONES (MODAL)
    // ========================================

    async function abrirConversacion(usuarioId) {
      try {
        usuarioConversacionActual = usuarioId;
        
        document.getElementById('loading-conversacion').classList.remove('d-none');
        document.getElementById('contenido-conversacion').classList.add('d-none');
        document.getElementById('form-respuesta-conversacion').classList.add('d-none');
        
        const response = await fetch(`/medico/comunicaciones/api/mensajes/conversacion/${usuarioId}`);
        const data = await response.json();
        
        document.getElementById('loading-conversacion').classList.add('d-none');
        
        if (data.success) {
          mostrarConversacion(data.data);
          document.getElementById('contenido-conversacion').classList.remove('d-none');
          document.getElementById('form-respuesta-conversacion').classList.remove('d-none');
        } else {
          document.getElementById('contenido-conversacion').innerHTML = `
            <div class="text-center py-4">
              <p class="text-muted">No hay mensajes con este usuario</p>
            </div>
          `;
          document.getElementById('contenido-conversacion').classList.remove('d-none');
        }
        
        const modal = new bootstrap.Modal(document.getElementById('modalConversacion'));
        modal.show();
      } catch (error) {
        console.error('Error al cargar conversación:', error);
        mostrarAlerta('error', 'Error al cargar conversación');
      }
    }

    function mostrarConversacion(mensajes) {
      const contenedor = document.getElementById('contenido-conversacion');
      
      if (!mensajes || mensajes.length === 0) {
        contenedor.innerHTML = `
          <div class="text-center py-4">
            <p class="text-muted">No hay mensajes en esta conversación</p>
          </div>
        `;
        return;
      }
      
      contenedor.innerHTML = mensajes.map(msg => {
        const fecha = new Date(msg.createdAt);
        const esPropio = msg.remitente_id !== usuarioConversacionActual;
        const nombre = esPropio ? 'Tú' : (msg.remitente?.nombre ? `${msg.remitente.nombre} ${msg.remitente.apellido}` : 'Usuario');
        
        return `
          <div class="d-flex mb-3 ${esPropio ? 'justify-content-end' : 'justify-content-start'}">
            <div class="card ${esPropio ? 'bg-primary text-white' : 'bg-light'}" style="max-width: 70%;">
              <div class="card-body p-2">
                <p class="card-text mb-1">${msg.mensaje}</p>
                <small class="${esPropio ? 'text-white-50' : 'text-muted'}">
                  ${nombre} - ${fecha.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' })}
                </small>
              </div>
            </div>
          </div>
        `;
      }).join('');
      
      // Scroll al final
      contenedor.scrollTop = contenedor.scrollHeight;
    }

    async function enviarRespuestaConversacion() {
      const mensaje = document.getElementById('mensajeRespuesta').value.trim();
      
      if (!mensaje) {
        mostrarAlerta('error', 'El mensaje no puede estar vacío');
        return;
      }
      
      try {
        const response = await fetch('/medico/comunicaciones/api/notificaciones', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            usuario_id: usuarioConversacionActual,
            mensaje: mensaje
          })
        });
        
        const data = await response.json();
        
        if (data.success) {
          document.getElementById('mensajeRespuesta').value = '';
          // Recargar conversación
          abrirConversacion(usuarioConversacionActual);
          // Actualizar conversaciones
          cargarConversaciones();
          // Actualizar mensajes enviados si está en esa pestaña
          if (vistaActual === 'enviados') {
            cargarMensajesEnviados();
          }
        } else {
          mostrarAlerta('error', data.message || 'Error al enviar mensaje');
        }
      } catch (error) {
        console.error('Error:', error);
        mostrarAlerta('error', 'Error al enviar mensaje');
      }
    }

    // ========================================
    // FUNCIONES DE ACCIÓN
    // ========================================

    async function marcarMensajeLeido(id) {
      try {
        const response = await fetch(`/medico/comunicaciones/api/notificaciones/${id}/leida`, {
          method: 'PUT'
        });
        
        const data = await response.json();
        
        if (data.success) {
          mostrarAlerta('success', 'Mensaje marcado como leído');
          cargarMensajesRecibidos(paginaRecibidos);
          cargarEstadisticas();
          cargarConversaciones();
        } else {
          mostrarAlerta('error', data.message || 'Error al marcar mensaje');
        }
      } catch (error) {
        console.error('Error:', error);
        mostrarAlerta('error', 'Error al marcar mensaje como leído');
      }
    }

    async function eliminarMensaje(id) {
      if (!confirm('¿Está seguro de eliminar este mensaje?')) return;
      
      try {
        const response = await fetch(`/medico/comunicaciones/api/notificaciones/${id}`, {
          method: 'DELETE'
        });
        
        const data = await response.json();
        
        if (data.success) {
          mostrarAlerta('success', 'Mensaje eliminado');
          
          // Recargar la vista actual
          switch(vistaActual) {
            case 'recibidos':
              cargarMensajesRecibidos(paginaRecibidos);
              break;
            case 'enviados':
              cargarMensajesEnviados(paginaEnviados);
              break;
          }
          
          // Actualizar estadísticas y conversaciones
          cargarEstadisticas();
          cargarConversaciones();
          
        } else {
          mostrarAlerta('error', data.message || 'Error al eliminar mensaje');
        }
      } catch (error) {
        console.error('Error:', error);
        mostrarAlerta('error', 'Error al eliminar mensaje');
      }
    }

    // ========================================
    // FUNCIONES UTILITARIAS
    // ========================================

    function mostrarPaginacion(elementId, pagination, funcion) {
      const paginacionDiv = document.getElementById(elementId);
      
      if (!pagination || pagination.totalPages <= 1) {
        paginacionDiv.innerHTML = '';
        return;
      }
      
      let html = `
        <li class="page-item ${pagination.page === 1 ? 'disabled' : ''}">
          <a class="page-link" href="#" onclick="${funcion.name}(${pagination.page - 1}); return false;">
            <i class="fas fa-chevron-left"></i>
          </a>
        </li>
      `;
      
      for (let i = 1; i <= Math.min(pagination.totalPages, 5); i++) {
        html += `
          <li class="page-item ${i === pagination.page ? 'active' : ''}">
            <a class="page-link" href="#" onclick="${funcion.name}(${i}); return false;">
              ${i}
            </a>
          </li>
        `;
      }
      
      html += `
        <li class="page-item ${pagination.page === pagination.totalPages ? 'disabled' : ''}">
          <a class="page-link" href="#" onclick="${funcion.name}(${pagination.page + 1}); return false;">
            <i class="fas fa-chevron-right"></i>
          </a>
        </li>
      `;
      
      paginacionDiv.innerHTML = html;
    }

    function calcularTiempoTranscurrido(fecha) {
      const ahora = new Date();
      const diferencia = ahora - fecha;
      const minutos = Math.floor(diferencia / 60000);
      const horas = Math.floor(diferencia / 3600000);
      const dias = Math.floor(diferencia / 86400000);

      if (minutos < 1) return 'Hace un momento';
      if (minutos < 60) return `Hace ${minutos} minuto${minutos !== 1 ? 's' : ''}`;
      if (horas < 24) return `Hace ${horas} hora${horas !== 1 ? 's' : ''}`;
      if (dias < 30) return `Hace ${dias} día${dias !== 1 ? 's' : ''}`;
      return fecha.toLocaleDateString('es-AR');
    }

    function debounce(fn, ms) {
      let timeout;
      return function(...args) {
        clearTimeout(timeout);
        timeout = setTimeout(() => fn.apply(this, args), ms);
      };
    }

    function mostrarAlerta(tipo, mensaje) {
      const alertContainer = document.createElement('div');
      alertContainer.className = `alert alert-${tipo === 'success' ? 'success' : tipo === 'info' ? 'info' : 'danger'} alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3`;
      alertContainer.style.zIndex = '9999';
      alertContainer.innerHTML = `
        <i class="fas fa-${tipo === 'success' ? 'check-circle' : tipo === 'info' ? 'info-circle' : 'exclamation-circle'} me-2"></i>
        ${mensaje}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      `;

      document.body.appendChild(alertContainer);

      setTimeout(() => {
        alertContainer.remove();
      }, 5000);
    }