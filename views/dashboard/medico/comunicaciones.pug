extends layout

block content
  .container-fluid.py-4
    .row
      .col-12
        .page-header.mb-4
          .d-flex.justify-content-between.align-items-center
            div
              h2
                i.fas.fa-comments.me-2
                | Comunicaciones
              p.text-muted Mensajes internos y noticias del hospital
            button.btn.btn-primary(data-bs-toggle='modal' data-bs-target='#modalNuevoMensaje')
              i.fas.fa-envelope.me-2
              | Nuevo Mensaje

    //- ESTADÍSTICAS
    .row.g-3.mb-4
      .col-lg-3.col-md-6
        .card.border-start.border-primary.border-4
          .card-body
            .d-flex.justify-content-between
              div
                small.text-muted Mensajes Recibidos
                h3.mb-0.text-primary#stat-total-recibidas
                  .spinner-border.spinner-border-sm
              i.fas.fa-inbox.fa-2x.text-primary
      
      .col-lg-3.col-md-6
        .card.border-start.border-warning.border-4
          .card-body
            .d-flex.justify-content-between
              div
                small.text-muted No Leídos
                h3.mb-0.text-warning#stat-no-leidas
                  .spinner-border.spinner-border-sm
              i.fas.fa-envelope.fa-2x.text-warning
      
      .col-lg-3.col-md-6
        .card.border-start.border-success.border-4
          .card-body
            .d-flex.justify-content-between
              div
                small.text-muted Mensajes Enviados
                h3.mb-0.text-success#stat-enviadas
                  .spinner-border.spinner-border-sm
              i.fas.fa-paper-plane.fa-2x.text-success
      
      .col-lg-3.col-md-6
        .card.border-start.border-info.border-4
          .card-body
            .d-flex.justify-content-between
              div
                small.text-muted Últimas 24h
                h3.mb-0.text-info#stat-24h
                  .spinner-border.spinner-border-sm
              i.fas.fa-clock.fa-2x.text-info

    .row
      //- MENSAJERÍA (Notificaciones)
      .col-lg-7
        .card.shadow-sm
          .card-header.bg-white.border-bottom
            ul.nav.nav-tabs.card-header-tabs#mensajesTabs(role='tablist')
              li.nav-item(role='presentation')
                button.nav-link.active.text-dark(
                  id='recibidos-tab'
                  data-bs-toggle='tab'
                  data-bs-target='#recibidos'
                  type='button'
                  role='tab'
                  aria-controls='recibidos'
                  aria-selected='true'
                )
                  i.fas.fa-inbox.me-2
                  | Bandeja de Entrada
                  span.badge.bg-primary.rounded-pill.ms-2#badge-recibidos 0
              li.nav-item(role='presentation')
                button.nav-link.text-dark(
                  id='enviados-tab'
                  data-bs-toggle='tab'
                  data-bs-target='#enviados'
                  type='button'
                  role='tab'
                  aria-controls='enviados'
                  aria-selected='false'
                )
                  i.fas.fa-paper-plane.me-2
                  | Mensajes Enviados
                  span.badge.bg-success.rounded-pill.ms-2#badge-enviados 0
              li.nav-item(role='presentation')
                button.nav-link.text-dark(
                  id='conversaciones-tab'
                  data-bs-toggle='tab'
                  data-bs-target='#conversaciones'
                  type='button'
                  role='tab'
                  aria-controls='conversaciones'
                  aria-selected='false'
                )
                  i.fas.fa-comments.me-2
                  | Conversaciones
                  span.badge.bg-info.rounded-pill.ms-2#badge-conversaciones 0

          .card-body
            .tab-content#mensajesTabContent
              //- MENSAJES RECIBIDOS
              .tab-pane.fade.show.active(
                id='recibidos'
                role='tabpanel'
                aria-labelledby='recibidos-tab'
              )
                .d-flex.justify-content-between.mb-3
                  select.form-select.form-select-sm.w-auto#filtroLeidosRecibidos(onchange='cargarMensajesRecibidos()')
                    option(value='TODAS') Todos los mensajes
                    option(value='false') Solo no leídos
                    option(value='true') Solo leídos
                  button.btn.btn-sm.btn-outline-primary(onclick='cargarMensajesRecibidos()')
                    i.fas.fa-sync-alt.me-1
                    | Actualizar

                #loading-recibidos.text-center.py-4
                  .spinner-border.text-primary
                  p.mt-2.text-muted Cargando mensajes...
                
                #contenido-recibidos
                nav.mt-3
                  ul.pagination.pagination-sm.justify-content-center#paginacion-recibidos

              //- MENSAJES ENVIADOS
              .tab-pane.fade(
                id='enviados'
                role='tabpanel'
                aria-labelledby='enviados-tab'
              )
                .d-flex.justify-content-end.mb-3
                  button.btn.btn-sm.btn-outline-success(onclick='cargarMensajesEnviados()')
                    i.fas.fa-sync-alt.me-1
                    | Actualizar

                #loading-enviados.text-center.py-4
                  .spinner-border.text-success
                  p.mt-2.text-muted Cargando mensajes...
                
                #contenido-enviados
                nav.mt-3
                  ul.pagination.pagination-sm.justify-content-center#paginacion-enviados

              //- CONVERSACIONES
              .tab-pane.fade(
                id='conversaciones'
                role='tabpanel'
                aria-labelledby='conversaciones-tab'
              )
                .d-flex.justify-content-end.mb-3
                  button.btn.btn-sm.btn-outline-info(onclick='cargarConversaciones()')
                    i.fas.fa-sync-alt.me-1
                    | Actualizar

                #loading-conversaciones.text-center.py-4
                  .spinner-border.text-info
                  p.mt-2.text-muted Cargando conversaciones...
                
                #contenido-conversaciones

      //- NOTICIAS DEL HOSPITAL
      .col-lg-5
        .card.shadow-sm
          .card-header.bg-white
            h5.mb-0
              i.fas.fa-newspaper.me-2
              | Noticias del Hospital

          .card-body
            //- LOADING
            #loading-noticias.text-center.py-4
              .spinner-border.text-primary
              p.mt-2.text-muted Cargando noticias...

            //- LISTA
            #lista-noticias.d-none
              #contenido-noticias
              nav.mt-3
                ul.pagination.pagination-sm.justify-content-center#paginacion-noticias

            //- SIN RESULTADOS
            #sin-noticias.text-center.py-4.d-none
              i.fas.fa-newspaper.fa-3x.text-muted.mb-3
              p.text-muted No hay noticias disponibles

  //- MODAL NUEVO MENSAJE
  #modalNuevoMensaje.modal.fade(tabindex='-1')
    .modal-dialog
      .modal-content
        .modal-header
          h5.modal-title
            i.fas.fa-envelope.me-2
            | Nuevo Mensaje
          button.btn-close(data-bs-dismiss='modal' aria-label='Close')
        .modal-body
          form#formNuevoMensaje
            .mb-3
              label.form-label
                i.fas.fa-user.me-1
                | Destinatario *
              .input-group
                input.form-control#buscarUsuario(
                  type='text'
                  placeholder='Nombre, email o DNI...'
                  autocomplete='off'
                )
                button.btn.btn-outline-secondary(type='button' onclick='limpiarBusqueda()')
                  i.fas.fa-times
              
              //- RESULTADOS BÚSQUEDA
              #resultadosBusqueda.mt-2.d-none
                .list-group#listaBusqueda

              //- USUARIO SELECCIONADO
              #usuarioSeleccionado.alert.alert-info.mt-2.d-none
                span#usuarioSeleccionadoNombre
                button.btn.btn-sm.btn-outline-secondary.float-end(type='button' onclick='deseleccionarUsuario()')
                  i.fas.fa-times
            
            .mb-3
              label.form-label
                i.fas.fa-file-alt.me-1
                | Mensaje *
              textarea.form-control(
                id='mensajeNuevo'
                rows='4'
                placeholder='Escribe tu mensaje aquí...'
                required
              )

        .modal-footer
          button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cerrar
          button.btn.btn-primary(type='submit' form='formNuevoMensaje')
            i.fas.fa-paper-plane.me-1
            | Enviar Mensaje

  //- MODAL VER NOTICIA COMPLETA
  #modalVerNoticia.modal.fade(tabindex='-1')
    .modal-dialog.modal-lg
      .modal-content
        .modal-header
          h5.modal-title
            i.fas.fa-newspaper.me-2
            | Noticia
          button.btn-close(data-bs-dismiss='modal' aria-label='Close')
        .modal-body#modalNoticiaBody
          .text-center.py-4
            .spinner-border.text-primary

  //- MODAL VER CONVERSACIÓN
  #modalConversacion.modal.fade(tabindex='-1')
    .modal-dialog.modal-lg
      .modal-content
        .modal-header
          h5.modal-title
            i.fas.fa-comments.me-2
            | Conversación
          button.btn-close(data-bs-dismiss='modal' aria-label='Close')
        .modal-body
          #loading-conversacion.text-center.py-4
            .spinner-border.text-primary
            p.mt-2.text-muted Cargando conversación...
          #contenido-conversacion.d-none
          #form-respuesta-conversacion.mt-3.d-none
            textarea.form-control#mensajeRespuesta(rows='3' placeholder='Escribe tu respuesta...')
            button.btn.btn-primary.mt-2(onclick='enviarRespuestaConversacion()')
              i.fas.fa-paper-plane.me-1
              | Enviar
        .modal-footer
          button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cerrar

block scripts
  style.
    /* Estilos para las tabs - Bootstrap puro con ajustes */
    .nav-tabs .nav-link {
      color: #6c757d !important; /* Gris Bootstrap */
      background-color: #f8f9fa; /* Fondo claro */
      border: 1px solid #dee2e6;
      border-bottom: 0;
      margin-bottom: -1px;
    }
    
    .nav-tabs .nav-link:hover {
      color: #495057 !important; /* Gris más oscuro al hover */
      background-color: #e9ecef;
    }
    
    .nav-tabs .nav-link.active {
      color: #fff !important; /* Blanco cuando está activo */
      background-color: #0d6efd; /* Azul Bootstrap primary */
      border-color: #0d6efd #dee2e6 #fff;
    }
    
    /* Colores específicos para cada tab activa */
    #recibidos-tab.active {
      background-color: #0d6efd; /* Azul */
    }
    
    #enviados-tab.active {
      background-color: #198754; /* Verde */
    }
    
    #conversaciones-tab.active {
      background-color: #0dcaf0; /* Azul claro */
    }

  script.
    // ========================================
    // VARIABLES GLOBALES
    // ========================================
    let paginaRecibidos = 1;
    let paginaEnviados = 1;
    let paginaNoticias = 1;
    const itemsPorPagina = 10;
    let usuarioSeleccionado = null;
    let usuarioConversacionActual = null;
    let vistaActual = 'recibidos';

    // ========================================
    // INICIALIZACIÓN
    // ========================================
    document.addEventListener('DOMContentLoaded', function() {
      console.log('🔔 Iniciando comunicaciones...');
      cargarEstadisticas();
      cargarMensajesRecibidos();
      cargarNoticias();
      setupBuscadorUsuarios();

      // Escuchar cambios de tabs de mensajería
      const tabs = document.querySelectorAll('#mensajesTabs button');
      tabs.forEach(tab => {
        tab.addEventListener('shown.bs.tab', function(event) {
          const targetId = event.target.getAttribute('data-bs-target');
          vistaActual = targetId.replace('#', '');
          
          switch(vistaActual) {
            case 'recibidos':
              cargarMensajesRecibidos();
              break;
            case 'enviados':
              cargarMensajesEnviados();
              break;
            case 'conversaciones':
              cargarConversaciones();
              break;
          }
        });
      });
    });

    // ========================================
    // FUNCIONES DE ESTADÍSTICAS
    // ========================================

    async function cargarEstadisticas() {
      try {
        console.log('📊 Cargando estadísticas...');
        const response = await fetch('/medico/comunicaciones/api/notificaciones/estadisticas');
        const data = await response.json();

        if (data.success) {
          document.getElementById('stat-total-recibidas').textContent = data.data.totalRecibidas;
          document.getElementById('stat-no-leidas').textContent = data.data.noLeidas;
          document.getElementById('stat-enviadas').textContent = data.data.totalEnviadas;
          document.getElementById('stat-24h').textContent = data.data.ultimas24h;
          console.log('✅ Estadísticas cargadas:', data.data);
        }
      } catch (error) {
        console.error('❌ Error al cargar estadísticas:', error);
      }
    }

    // ========================================
    // FUNCIONES DE MENSAJES RECIBIDOS
    // ========================================

    async function cargarMensajesRecibidos(pagina = 1) {
      try {
        paginaRecibidos = pagina;
        
        const filtro = document.getElementById('filtroLeidosRecibidos')?.value || 'TODAS';
        const params = new URLSearchParams({
          page: pagina,
          limit: itemsPorPagina,
          leida: filtro
        });

        document.getElementById('loading-recibidos').classList.remove('d-none');
        document.getElementById('contenido-recibidos').innerHTML = '';
        document.getElementById('paginacion-recibidos').innerHTML = '';
        
        const response = await fetch(`/medico/comunicaciones/api/notificaciones?${params.toString()}`);
        const data = await response.json();

        document.getElementById('loading-recibidos').classList.add('d-none');
        
        if (data.success && data.data.length > 0) {
          console.log('✅ Mensajes recibidos cargados:', data.data.length);
          mostrarMensajesRecibidos(data.data);
          mostrarPaginacion('paginacion-recibidos', data.pagination, cargarMensajesRecibidos);
          // Actualizar badge
          document.getElementById('badge-recibidos').textContent = data.pagination?.total || 0;
          document.getElementById('badge-recibidos').classList.remove('d-none');
        } else {
          document.getElementById('contenido-recibidos').innerHTML = `
            <div class="text-center py-4">
              <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
              <p class="text-muted">No hay mensajes recibidos</p>
            </div>
          `;
          document.getElementById('badge-recibidos').classList.add('d-none');
        }
      } catch (error) {
        console.error('❌ Error al cargar mensajes recibidos:', error);
        mostrarAlerta('error', 'Error al cargar mensajes');
      }
    }

    function mostrarMensajesRecibidos(mensajes) {
      const contenedor = document.getElementById('contenido-recibidos');
      
      contenedor.innerHTML = mensajes.map(msg => {
        const fecha = new Date(msg.createdAt);
        const remitenteNombre = msg.remitente ? `${msg.remitente.nombre} ${msg.remitente.apellido}` : 'Sistema';
        
        return `
          <div class="card mb-2 ${!msg.leida ? 'border-warning' : ''}">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1">
                  <h6 class="card-title mb-1">
                    <i class="fas fa-user me-2"></i>
                    ${remitenteNombre}
                    ${!msg.leida ? '<span class="badge bg-warning text-dark ms-2">Nuevo</span>' : ''}
                  </h6>
                  <p class="card-text mb-2">${msg.mensaje}</p>
                  <small class="text-muted">
                    <i class="fas fa-clock me-1"></i>
                    ${fecha.toLocaleString('es-AR')}
                  </small>
                </div>
                <div class="btn-group-vertical btn-group-sm ms-2">
                  ${!msg.leida ? `
                    <button class="btn btn-sm btn-outline-success" onclick="marcarMensajeLeido(${msg.id})" title="Marcar como leído">
                      <i class="fas fa-check"></i>
                    </button>
                  ` : ''}
                  ${msg.remitente ? `
                    <button class="btn btn-sm btn-outline-info" onclick="responderMensaje(${msg.remitente.id}, '${msg.remitente.nombre} ${msg.remitente.apellido}')" title="Responder">
                      <i class="fas fa-reply"></i>
                    </button>
                  ` : ''}
                  <button class="btn btn-sm btn-outline-danger" onclick="eliminarMensaje(${msg.id})" title="Eliminar">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // ========================================
    // FUNCIONES DE MENSAJES ENVIADOS
    // ========================================

    async function cargarMensajesEnviados(pagina = 1) {
      try {
        paginaEnviados = pagina;
        
        const params = new URLSearchParams({
          page: pagina,
          limit: itemsPorPagina
        });

        document.getElementById('loading-enviados').classList.remove('d-none');
        document.getElementById('contenido-enviados').innerHTML = '';
        document.getElementById('paginacion-enviados').innerHTML = '';
        
        const response = await fetch(`/medico/comunicaciones/api/mensajes/enviados?${params.toString()}`);
        const data = await response.json();

        document.getElementById('loading-enviados').classList.add('d-none');
        
        if (data.success && data.data.length > 0) {
          console.log('✅ Mensajes enviados cargados:', data.data.length);
          mostrarMensajesEnviados(data.data);
          mostrarPaginacion('paginacion-enviados', data.pagination, cargarMensajesEnviados);
          // Actualizar badge
          document.getElementById('badge-enviados').textContent = data.pagination?.total || 0;
          document.getElementById('badge-enviados').classList.remove('d-none');
        } else {
          document.getElementById('contenido-enviados').innerHTML = `
            <div class="text-center py-4">
              <i class="fas fa-paper-plane fa-3x text-muted mb-3"></i>
              <p class="text-muted">No hay mensajes enviados</p>
            </div>
          `;
          document.getElementById('badge-enviados').classList.add('d-none');
        }
      } catch (error) {
        console.error('❌ Error al cargar mensajes enviados:', error);
        mostrarAlerta('error', 'Error al cargar mensajes');
      }
    }

    function mostrarMensajesEnviados(mensajes) {
      const contenedor = document.getElementById('contenido-enviados');
      
      contenedor.innerHTML = mensajes.map(msg => {
        const fecha = new Date(msg.createdAt);
        const destinatarioNombre = msg.destinatario ? `${msg.destinatario.nombre} ${msg.destinatario.apellido}` : 'Usuario';
        
        return `
          <div class="card mb-2">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1">
                  <h6 class="card-title mb-1">
                    <i class="fas fa-user me-2"></i>
                    Para: ${destinatarioNombre}
                    ${msg.leida ? '<span class="badge bg-success ms-2">Leído</span>' : '<span class="badge bg-secondary ms-2">No leído</span>'}
                  </h6>
                  <p class="card-text mb-2">${msg.mensaje}</p>
                  <small class="text-muted">
                    <i class="fas fa-clock me-1"></i>
                    Enviado: ${fecha.toLocaleString('es-AR')}
                  </small>
                </div>
                <div class="btn-group-vertical btn-group-sm ms-2">
                  <button class="btn btn-sm btn-outline-danger" onclick="eliminarMensaje(${msg.id})" title="Eliminar">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // ========================================
    // FUNCIONES DE CONVERSACIONES
    // ========================================

    async function cargarConversaciones() {
      try {
        document.getElementById('loading-conversaciones').classList.remove('d-none');
        document.getElementById('contenido-conversaciones').innerHTML = '';
        
        const response = await fetch('/medico/comunicaciones/api/mensajes/conversaciones');
        const data = await response.json();

        document.getElementById('loading-conversaciones').classList.add('d-none');
        
        if (data.success && data.data.length > 0) {
          console.log('✅ Conversaciones cargadas:', data.data.length);
          mostrarConversaciones(data.data);
          // Actualizar badge
          const totalNoLeidos = data.data.reduce((sum, conv) => sum + (conv.no_leidos || 0), 0);
          document.getElementById('badge-conversaciones').textContent = totalNoLeidos;
          document.getElementById('badge-conversaciones').classList.remove('d-none');
        } else {
          document.getElementById('contenido-conversaciones').innerHTML = `
            <div class="text-center py-4">
              <i class="fas fa-comments fa-3x text-muted mb-3"></i>
              <p class="text-muted">No hay conversaciones</p>
            </div>
          `;
          document.getElementById('badge-conversaciones').classList.add('d-none');
        }
      } catch (error) {
        console.error('❌ Error al cargar conversaciones:', error);
        mostrarAlerta('error', 'Error al cargar conversaciones');
      }
    }

    function mostrarConversaciones(conversaciones) {
      const contenedor = document.getElementById('contenido-conversaciones');
      
      contenedor.innerHTML = conversaciones.map(conv => {
        const fecha = new Date(conv.ultima_fecha);
        const usuarioNombre = conv.usuario ? `${conv.usuario.nombre} ${conv.usuario.apellido}` : 'Usuario';
        
        return `
          <div class="card mb-2">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1">
                  <h6 class="card-title mb-1">
                    <i class="fas fa-user me-2"></i>
                    ${usuarioNombre}
                    ${conv.no_leidos > 0 ? `<span class="badge bg-danger ms-2">${conv.no_leidos} nuevo(s)</span>` : ''}
                  </h6>
                  <p class="card-text mb-2 text-muted">
                    <small>
                      ${conv.es_enviado ? '<i class="fas fa-share me-1"></i> Tú:' : '<i class="fas fa-reply me-1"></i>'}
                      ${conv.ultimo_mensaje?.substring(0, 100) || 'Sin mensajes'}...
                    </small>
                  </p>
                  <small class="text-muted">
                    <i class="fas fa-clock me-1"></i>
                    ${calcularTiempoTranscurrido(fecha)}
                  </small>
                </div>
                <div class="btn-group-vertical btn-group-sm ms-2">
                  <button class="btn btn-sm btn-outline-primary" onclick="abrirConversacion(${conv.usuario?.id})" title="Abrir conversación">
                    <i class="fas fa-comments"></i>
                  </button>
                  <button class="btn btn-sm btn-outline-info" onclick="responderMensaje(${conv.usuario?.id}, '${usuarioNombre}')" title="Responder">
                    <i class="fas fa-reply"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // ========================================
    // FUNCIONES DE NOTICIAS
    // ========================================

    async function cargarNoticias(pagina = 1) {
      try {
        paginaNoticias = pagina;

        const params = new URLSearchParams({
          page: pagina,
          limit: 5
        });

        document.getElementById('loading-noticias').classList.remove('d-none');
        document.getElementById('lista-noticias').classList.add('d-none');
        document.getElementById('sin-noticias').classList.add('d-none');

        const response = await fetch(`/medico/comunicaciones/api/noticias?${params.toString()}`);
        const data = await response.json();

        document.getElementById('loading-noticias').classList.add('d-none');

        if (data.success && data.data.length > 0) {
          console.log('✅ Noticias cargadas:', data.data.length);
          mostrarNoticias(data.data);
          mostrarPaginacion('paginacion-noticias', data.pagination, cargarNoticias);
          document.getElementById('lista-noticias').classList.remove('d-none');
        } else {
          console.log('ℹ️ Sin noticias');
          document.getElementById('sin-noticias').classList.remove('d-none');
        }
      } catch (error) {
        console.error('❌ Error al cargar noticias:', error);
        document.getElementById('loading-noticias').classList.add('d-none');
        mostrarAlerta('error', 'Error al cargar noticias');
      }
    }

    function mostrarNoticias(noticias) {
