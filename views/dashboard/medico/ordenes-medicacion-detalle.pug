extends layout

block content
  .container-fluid
    // Header
    .row.mb-4
      .col-12
        nav(aria-label="breadcrumb")
          ol.breadcrumb
            li.breadcrumb-item
              a(href="/medico") Dashboard
            li.breadcrumb-item
              a(href="/medico/ordenes-medicacion") Órdenes de Medicación
            li.breadcrumb-item.active Detalle
        
        .d-flex.justify-content-between.align-items-center
          div
            h2.mb-1
              i.fas.fa-pills.me-2
              | Detalle de Medicación
            p.text-muted.mb-0 Receta ##{receta.id}
          div
            a.btn.btn-outline-secondary(href="/medico/ordenes-medicacion")
              i.fas.fa-arrow-left.me-2
              | Volver

    .row
      .col-lg-8
        // Estado
        .card.border-0.shadow-sm.mb-4
          .card-body
            .d-flex.justify-content-between.align-items-center
              div
                h5.mb-1
                  i.fas.fa-info-circle.me-2
                  | Estado de la Receta
                if receta.estado === 'ADMINISTRADA'
                  h3
                    span.badge.bg-success.p-3
                      i.fas.fa-check-circle.me-2
                      | ADMINISTRADA
                  p.text-muted.mb-0 Última administración: #{new Date(receta.ultima_administracion).toLocaleString('es-AR')}
                else if receta.estado === 'CANCELADA'
                  h3
                    span.badge.bg-danger.p-3
                      i.fas.fa-times-circle.me-2
                      | CANCELADA
                  p.text-muted.mb-0 Esta receta fue cancelada
                else
                  h3
                    span.badge.bg-warning.text-dark.p-3
                      i.fas.fa-clock.me-2
                      | PENDIENTE
                  p.text-muted.mb-0 Esta medicación aún no ha sido administrada
              div
                if receta.prioridad === 'MEDIA'
                  span.badge.bg-warning.text-dark.p-3.fs-5 MEDIA
                else if receta.prioridad === 'ALTA'
                  span.badge.bg-danger.p-3.fs-5 ALTA
                else
                  span.badge.bg-secondary.p-3.fs-5 BAJA

        // Receta médica
        .card.border-0.shadow-sm.mb-4
          .card-header.bg-white
            h5.mb-0
              i.fas.fa-prescription.me-2
              | Receta Médica
          .card-body
            .row
              .col-md-6.mb-3
                strong
                  i.fas.fa-calendar.me-2
                  | Fecha de Prescripción:
                p.mb-0= new Date(receta.fecha).toLocaleString('es-AR')
              
              .col-md-6.mb-3
                strong
                  i.fas.fa-flag.me-2
                  | Prioridad:
                if receta.prioridad === 'MEDIA'
                  span.badge.bg-warning.text-dark MEDIA 
                else if receta.prioridad === 'ALTA'
                  span.badge.bg-danger ALTA
                else
                  span.badge.bg-secondary BAJA
              
              if receta.requiere_monitoreo
                .col-12.mb-3
                  .alert.alert-warning
                    i.fas.fa-heartbeat.me-2
                    strong REQUIERE MONITOREO ESTRICTO
                    br
                    | El enfermero debe controlar signos vitales pre y post administración
              
              .col-12
                strong
                  i.fas.fa-pills.me-2
                  | Contenido de la Receta:
                pre.bg-light.p-3.rounded(style="white-space: pre-wrap; font-family: inherit;")= receta.contenido

        // Paciente
        .card.border-0.shadow-sm.mb-4
          .card-header.bg-white
            h5.mb-0
              i.fas.fa-user.me-2
              | Datos del Paciente
          .card-body
            .row
              .col-md-6.mb-3
                strong
                  i.fas.fa-id-card.me-2
                  | Nombre:
                p.mb-0= receta.paciente.usuario.nombre + ' ' + receta.paciente.usuario.apellido
              
              .col-md-6.mb-3
                strong
                  i.fas.fa-hashtag.me-2
                  | DNI:
                p.mb-0= receta.paciente.usuario.dni
              
              .col-md-6.mb-3
                strong
                  i.fas.fa-calendar.me-2
                  | Edad:
                p.mb-0= edadPaciente + ' años'
              
              .col-md-6.mb-3
                strong
                  i.fas.fa-venus-mars.me-2
                  | Sexo:
                p.mb-0= receta.paciente.usuario.sexo

        // Historial de administraciones
        if administraciones && administraciones.length > 0
          .card.border-0.shadow-sm.mb-4
            .card-header.bg-success.text-white
              h5.mb-0
                i.fas.fa-history.me-2
                | Historial de Administraciones
            .card-body
              each admin in administraciones
                .mb-3.pb-3.border-bottom
                  .row
                    .col-md-6.mb-2
                      strong
                        i.fas.fa-user-nurse.me-2
                        | Enfermero:
                      p.mb-0= admin.enfermero ? `${admin.enfermero.usuario.nombre} ${admin.enfermero.usuario.apellido}` : 'No registrado'
                    
                    .col-md-6.mb-2
                      strong
                        i.fas.fa-calendar-check.me-2
                        | Fecha:
                      p.mb-0= new Date(admin.fecha).toLocaleString('es-AR')
                    
                    .col-12
                      strong
                        i.fas.fa-notes-medical.me-2
                        | Observaciones:
                      p.mb-0(style="white-space: pre-wrap;")= admin.observaciones

      // Sidebar
      .col-lg-4
        // Acciones
        .card.border-0.shadow-sm.mb-4
          .card-header.bg-white
            h5.mb-0
              i.fas.fa-tasks.me-2
              | Acciones
          .card-body
            if receta.estado === 'PENDIENTE'
              a.btn.btn-warning.w-100.mb-2(href=`/medico/ordenes-medicacion/${receta.id}/editar`)
                i.fas.fa-edit.me-2
                | Editar Receta
              
              button.btn.btn-danger.w-100(
                type="button"
                onclick=`cancelarReceta(${receta.id})`
              )
                i.fas.fa-ban.me-2
                | Cancelar Receta
            else
              .alert.alert-info.mb-0
                i.fas.fa-info-circle.me-2
                if receta.administrada
                  | Esta receta ya fue administrada
                else
                  | Esta receta fue cancelada

        // Información del médico
        .card.border-0.shadow-sm.mb-4
          .card-header.bg-white
            h5.mb-0
              i.fas.fa-user-md.me-2
              | Médico Prescriptor
          .card-body
            p.mb-2
              strong= `Dr. ${receta.medico.usuario.nombre} ${receta.medico.usuario.apellido}`
            
            if receta.evaluacionMedica
              hr
              a.btn.btn-outline-primary.w-100(
                href=`/medico/evaluaciones/${receta.evaluacionMedica.id}`
              )
                i.fas.fa-stethoscope.me-2
                | Ver Evaluación

        // Alertas
        if receta.requiere_monitoreo
          .card.border-0.shadow-sm.border-warning
            .card-header.bg-warning.text-dark
              h5.mb-0
                i.fas.fa-exclamation-triangle.me-2
                | Importante
            .card-body
              p.mb-0
                strong Monitoreo Requerido
                br
                | Esta medicación requiere control estricto de signos vitales antes y después de cada administración.

block scripts
  script.
    function cancelarReceta(id) {
      if (confirm('¿Está seguro de cancelar esta receta?\n\nEsta acción no se puede deshacer.')) {
        const motivo = prompt('Ingrese el motivo de cancelación:');
        
        if (motivo && motivo.trim() !== '') {
          fetch(`/medico/ordenes-medicacion/${id}`, {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ motivo_cancelacion: motivo })
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              alert(data.message);
              window.location.href = '/medico/ordenes-medicacion';
            } else {
              alert('Error: ' + data.message);
            }
          })
          .catch(error => {
            console.error('Error:', error);
            alert('Error al cancelar la receta');
          });
        }
      }
    }