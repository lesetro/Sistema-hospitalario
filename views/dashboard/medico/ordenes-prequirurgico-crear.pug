extends layout

block content
  .container-fluid
    // Breadcrumb y header
    .row.mb-4
      .col-12
        nav(aria-label="breadcrumb")
          ol.breadcrumb
            li.breadcrumb-item
              a(href="/medico") Dashboard
            li.breadcrumb-item
              a(href="/medico/ordenes-prequirurgico") Órdenes Pre-quirúrgicas
            li.breadcrumb-item.active Crear Orden
        
        .d-flex.justify-content-between.align-items-center
          div
            h2.mb-1
              i.fas.fa-notes-medical.me-2
              | Crear Orden Pre-quirúrgica
            p.text-muted.mb-0 Preparación del paciente antes de intervención quirúrgica
          div
            a.btn.btn-outline-secondary(href="/medico/ordenes-prequirurgico")
              i.fas.fa-arrow-left.me-2
              | Volver

    // Formulario
    .row
      .col-lg-8.mx-auto
        .card.border-0.shadow-sm
          .card-header.bg-white
            h5.mb-0
              i.fas.fa-file-medical.me-2
              | Datos de la Orden Pre-quirúrgica
          
          .card-body
            form#form-crear-prequirurgico(method="POST" action="/medico/ordenes-prequirurgico/crear")
              
              // Selección de paciente
              .mb-4
                label.form-label
                  i.fas.fa-user.me-2
                  | Paciente
                  span.text-danger *
                if paciente
                  .alert.alert-info
                    strong #{paciente.usuario.nombre} #{paciente.usuario.apellido}
                    br
                    small DNI: #{paciente.usuario.dni}
                  input(type="hidden" name="paciente_id" value=paciente.id)
                  if evaluacion
                    input(type="hidden" name="evaluacion_medica_id" value=evaluacion.id)
                  if intervencion
                    input(type="hidden" name="intervencion_quirurgica_id" value=intervencion.id)
                else
                  input.form-control(
                    type="text"
                    id="buscar-paciente"
                    placeholder="Buscar paciente por nombre, apellido o DNI..."
                    autocomplete="off"
                  )
                  input(type="hidden" name="paciente_id" id="paciente_id" required)
                  #resultados-paciente.list-group.mt-2(style="display: none;")

              
              .mb-4#evaluaciones-container(style="display: none;")
                label.form-label(for="evaluacion_medica_id")
                  i.fas.fa-stethoscope.me-2
                  | Evaluación Médica Asociada
                  span.text-danger *
                select.form-select(id="evaluacion_medica_id" name="evaluacion_medica_id" required)
                  option(value="" disabled selected) -- Seleccione una evaluación --
                .form-text Seleccione la evaluación médica que originó esta orden pre-quirúrgica

              
              .mb-4#intervenciones-container(style="display: none;")
                label.form-label(for="intervencion_quirurgica_id")
                  i.fas.fa-syringe.me-2
                  | Intervención Quirúrgica Asociada (opcional)
                select.form-select(id="intervencion_quirurgica_id" name="intervencion_quirurgica_id")
                  option(value="" selected) -- Sin intervención asociada --
                .form-text Opcional: Seleccione la intervención quirúrgica si ya está programada

              hr

              // Nombre
              .mb-3
                label.form-label(for="nombre")
                  i.fas.fa-tag.me-2
                  | Nombre de la Preparación
                input.form-control(
                  type="text"
                  id="nombre"
                  name="nombre"
                  value="Preparación Pre-quirúrgica"
                  required
                )

              // Descripción
              .mb-3
                label.form-label(for="descripcion")
                  i.fas.fa-align-left.me-2
                  | Descripción de la Cirugía
                  span.text-danger *
                textarea.form-control(
                  id="descripcion"
                  name="descripcion"
                  rows="3"
                  placeholder="Describa la intervención quirúrgica programada..."
                  required
                )

              // Observaciones especiales
              .mb-3
                label.form-label(for="observaciones_especiales")
                  i.fas.fa-exclamation-triangle.me-2
                  | Observaciones Especiales del Médico
                textarea.form-control(
                  id="observaciones_especiales"
                  name="observaciones_especiales"
                  rows="3"
                  placeholder="Alergias, contraindicaciones, precauciones especiales..."
                )
                .form-text Información importante que debe conocer el enfermero

              // Checklist requerido
              .mb-3
                label.form-label(for="checklist_requerido")
                  i.fas.fa-list-check.me-2
                  | Checklist Específico
                textarea.form-control(
                  id="checklist_requerido"
                  name="checklist_requerido"
                  rows="4"
                  placeholder="Agregue items específicos adicionales al checklist estándar..."
                )
                .form-text El checklist estándar siempre se incluye. Agregue solo items adicionales específicos para este paciente.

              // Prioridad
              .mb-3
                label.form-label(for="prioridad")
                  i.fas.fa-flag.me-2
                  | Prioridad
                  span.text-danger *
                select.form-select(id="prioridad" name="prioridad" required)
                  option(value="ALTA" selected) Alta
                  option(value="URGENTE") Urgente
                  option(value="NORMAL") Normal

              .alert.alert-info
                i.fas.fa-info-circle.me-2
                strong Checklist estándar incluido:
                ul.mb-0.mt-2
                  li Ayuno de 8-12 horas
                  li Higiene corporal completa
                  li Retiro de joyas y accesorios
                  li Retiro de prótesis dentales
                  li Retiro de esmalte de uñas
                  li Consentimiento informado firmado
                  li Estudios pre-operatorios disponibles
                  li Vía venosa permeable
                  li Alergias verificadas y documentadas

              hr

              // Botones
              .d-grid.gap-2.d-md-flex.justify-content-md-end
                button.btn.btn-secondary(type="button" onclick="window.history.back()")
                  i.fas.fa-times.me-2
                  | Cancelar
                button.btn.btn-primary(type="submit")
                  i.fas.fa-save.me-2
                  | Crear Orden Pre-quirúrgica

block scripts
  script(src="/js/medico/ordenes-prequirurgico.js")