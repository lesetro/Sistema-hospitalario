extends layout

block content
  .container-fluid
    // Header con breadcrumb
    .row.mb-4
      .col-12
        nav(aria-label="breadcrumb")
          ol.breadcrumb
            li.breadcrumb-item
              a(href="/medico/camas") Dashboard Camas
            li.breadcrumb-item
              a(href="/medico/camas/sectores") Mi Sector
            li.breadcrumb-item.active Servicios
        
        .d-flex.justify-content-between.align-items-center
          div
            h2.mb-1
              i.fas.fa-stethoscope.me-2
              | Servicios - #{sector.nombre}
            p.text-muted.mb-0 Selecciona un servicio para ver sus habitaciones
          div
            a.btn.btn-outline-secondary(href="/medico/camas/sectores")
              i.fas.fa-arrow-left.me-2
              | Volver

    // Información del sector
    .row.mb-4
      .col-12
        .card.border-0.shadow-sm
          .card-body
            .row.align-items-center
              .col-md-8
                h5.mb-2
                  i.fas.fa-hospital.me-2.text-primary
                  = sector.nombre
                if sector.descripcion
                  p.text-muted.mb-0= sector.descripcion
              .col-md-4.text-end
                .badge.bg-info.fs-6
                  = tiposServicio.length
                  = tiposServicio.length === 1 ? ' Servicio' : ' Servicios'

    // Lista de tipos de servicio
    .row
      if tiposServicio && tiposServicio.length > 0
        each servicio in tiposServicio
          .col-xl-6.col-lg-12.mb-4
            .card.border-0.shadow-sm.h-100.hover-card
              .card-header.bg-white.d-flex.justify-content-between.align-items-center
                h5.mb-0
                  i.fas.fa-heartbeat.me-2.text-primary
                  = servicio.nombre
                span.badge(class=servicio.estadisticas.porcentajeOcupacion > 80 ? 'bg-danger' : servicio.estadisticas.porcentajeOcupacion > 50 ? 'bg-warning text-dark' : 'bg-success')
                  = servicio.estadisticas.porcentajeOcupacion + '% ocupado'
              
              .card-body
                // Descripción
                if servicio.descripcion
                  p.card-text.text-muted.mb-3= servicio.descripcion
                
                // Estadísticas en grid
                .row.g-3.mb-3
                  .col-6
                    .card.border-0.bg-light
                      .card-body.text-center.p-3
                        .d-flex.align-items-center.justify-content-center.mb-2
                          .p-2.rounded-circle.bg-info.bg-opacity-10.me-2
                            i.fas.fa-door-open.text-info
                        h4.text-info.mb-1= servicio.estadisticas.totalHabitaciones
                        small.text-muted Habitaciones
                  
                  .col-6
                    .card.border-0.bg-light
                      .card-body.text-center.p-3
                        .d-flex.align-items-center.justify-content-center.mb-2
                          .p-2.rounded-circle.bg-primary.bg-opacity-10.me-2
                            i.fas.fa-bed.text-primary
                        h4.text-primary.mb-1= servicio.estadisticas.totalCamas
                        small.text-muted Total Camas
                  
                  .col-6
                    .card.border-0.bg-light
                      .card-body.text-center.p-3
                        .d-flex.align-items-center.justify-content-center.mb-2
                          .p-2.rounded-circle.bg-success.bg-opacity-10.me-2
                            i.fas.fa-check-circle.text-success
                        h4.text-success.mb-1= servicio.estadisticas.camasLibres
                        small.text-muted Camas Libres
                  
                  .col-6
                    .card.border-0.bg-light
                      .card-body.text-center.p-3
                        .d-flex.align-items-center.justify-content-center.mb-2
                          .p-2.rounded-circle.bg-danger.bg-opacity-10.me-2
                            i.fas.fa-user-injured.text-danger
                        h4.text-danger.mb-1= servicio.estadisticas.camasOcupadas
                        small.text-muted Ocupadas
                
                // Camas en limpieza (si hay)
                if servicio.estadisticas.camasLimpieza > 0
                  .alert.alert-warning.mb-3
                    i.fas.fa-broom.me-2
                    strong= servicio.estadisticas.camasLimpieza
                    = ' cama(s) en limpieza'
                
                // Barra de progreso
                .mb-2
                  .d-flex.justify-content-between.mb-1
                    small.text-muted Nivel de Ocupación
                    small.fw-bold(class=servicio.estadisticas.porcentajeOcupacion > 80 ? 'text-danger' : servicio.estadisticas.porcentajeOcupacion > 50 ? 'text-warning' : 'text-success')
                      = servicio.estadisticas.porcentajeOcupacion + '%'
                  .progress(style="height: 10px")
                    .progress-bar(
                      class=servicio.estadisticas.porcentajeOcupacion > 80 ? 'bg-danger' : servicio.estadisticas.porcentajeOcupacion > 50 ? 'bg-warning' : 'bg-success'
                      role="progressbar"
                      style=`width: ${servicio.estadisticas.porcentajeOcupacion}%`
                      aria-valuenow=servicio.estadisticas.porcentajeOcupacion
                      aria-valuemin="0"
                      aria-valuemax="100"
                    )
              
              .card-footer.bg-white.border-0.pt-0
                .d-grid.gap-2
                  a.btn.btn-primary(
                    href=`/medico/camas/sectores/${sector.id}/servicios/${servicio.id}/habitaciones`
                  )
                    i.fas.fa-door-open.me-2
                    | Ver Habitaciones
                  
                  if servicio.estadisticas.camasLibres > 0
                    button.btn.btn-outline-success(
                      type='button'
                      onclick=`verCamasDisponiblesServicio(${servicio.id})`
                    )
                      i.fas.fa-bed.me-2
                      = `${servicio.estadisticas.camasLibres} cama(s) disponible(s)`

      else
        .col-12
          .card.border-0.shadow-sm
            .card-body.text-center.py-5
              i.fas.fa-stethoscope.fa-4x.text-muted.mb-3
              h4 No hay servicios en este sector
              p.text-muted.mb-0 No se encontraron tipos de servicio asociados a este sector.

block scripts
  script.
    function verCamasDisponiblesServicio(servicioId) {
      window.location.href = `/medico/camas/disponibles?tipo_servicio_id=${servicioId}`;
    }
    
    // Agregar efecto hover a las cards
    document.addEventListener('DOMContentLoaded', function() {
      const cards = document.querySelectorAll('.hover-card');
      cards.forEach(card => {
        card.style.transition = 'transform 0.2s, box-shadow 0.2s';
        card.addEventListener('mouseenter', function() {
          this.style.transform = 'translateY(-5px)';
          this.style.boxShadow = '0 0.5rem 1rem rgba(0,0,0,0.15)';
        });
        card.addEventListener('mouseleave', function() {
          this.style.transform = 'translateY(0)';
          this.style.boxShadow = '';
        });
      });
    });

  style.
    .hover-card {
      cursor: pointer;
      transition: all 0.2s ease;
    }
    