extends layout

block content
  .container-fluid
    // Breadcrumb
    .row.mb-4
      .col-12
        nav(aria-label="breadcrumb")
          ol.breadcrumb
            li.breadcrumb-item
              a(href="/medico") Dashboard
            li.breadcrumb-item
              a(href="/medico/ordenes-internacion") Órdenes para Internados
            li.breadcrumb-item.active Crear Orden
        
        .d-flex.justify-content-between.align-items-center
          div
            h2.mb-1
              i.fas.fa-file-medical-alt.me-2
              | Crear Orden para Paciente Internado
            p.text-muted.mb-0 Indique las órdenes médicas a ejecutar por enfermería
          div
            a.btn.btn-outline-secondary(href="/medico/ordenes-internacion")
              i.fas.fa-arrow-left.me-2
              | Volver

    // Formulario
    .row
      .col-lg-8.mx-auto
        .card.border-0.shadow-sm
          .card-header.bg-white
            h5.mb-0
              i.fas.fa-prescription.me-2
              | Nueva Orden Médica
          
          .card-body
            if internacion
              // Si viene con internación preseleccionada
              .alert.alert-info.mb-4
                .d-flex.justify-content-between.align-items-center
                  div
                    strong
                      i.fas.fa-user.me-2
                      | #{internacion.paciente.usuario.nombre} #{internacion.paciente.usuario.apellido}
                    br
                    small.text-muted
                      i.fas.fa-id-card.me-1
                      | DNI: #{internacion.paciente.usuario.dni} | 
                      i.fas.fa-bed.me-1
                      | #{internacion.cama.habitacion.sector.nombre} - Hab. #{internacion.cama.habitacion.numero} - Cama #{internacion.cama.numero}
                  a.btn.btn-sm.btn-outline-primary(href="/medico/ordenes-internacion/crear")
                    i.fas.fa-search.me-1
                    | Cambiar paciente
              
              input(type="hidden" name="internacion_id" id="internacion_id" value=internacion.id)
              input(type="hidden" name="paciente_id" id="paciente_id" value=internacion.paciente.id)
            else
              // Buscador de internaciones
              .mb-4
                label.form-label
                  i.fas.fa-search.me-2
                  | Buscar paciente internado
                  span.text-danger *
                input.form-control(
                  type="text"
                  id="buscar-internacion"
                  placeholder="Buscar por nombre, apellido o DNI del paciente..."
                  autocomplete="off"
                )
                #resultados-internacion.list-group.mt-2(style="display: none;")
              
              input(type="hidden" name="internacion_id" id="internacion_id" required)
              input(type="hidden" name="paciente_id" id="paciente_id" required)

            hr

            // Tipo de orden
            .mb-3
              label.form-label(for="tipo_orden")
                i.fas.fa-tag.me-2
                | Tipo de Orden
                span.text-danger *
              select.form-select(id="tipo_orden" name="tipo_orden" required)
                option(value="") Seleccionar...
                option(value="Control de signos vitales") Control de signos vitales
                option(value="Administración de medicación") Administración de medicación
                option(value="Curación") Curación
                option(value="Cambio de posición") Cambio de posición
                option(value="Control de ingesta/egreso") Control de ingesta/egreso
                option(value="Higiene del paciente") Higiene del paciente
                option(value="Toma de muestra") Toma de muestra
                option(value="Otro") Otro

            // Descripción
            .mb-3
              label.form-label(for="descripcion")
                i.fas.fa-align-left.me-2
                | Descripción Detallada
                span.text-danger *
              textarea.form-control(
                id="descripcion"
                name="descripcion"
                rows="4"
                placeholder="Describa la orden a realizar. Ej: Administrar Ampicilina 1g IV cada 8 horas"
                required
              )

            // Indicaciones específicas
            .mb-3
              label.form-label(for="indicaciones_especificas")
                i.fas.fa-exclamation-circle.me-2
                | Indicaciones Específicas
              textarea.form-control(
                id="indicaciones_especificas"
                name="indicaciones_especificas"
                rows="3"
                placeholder="Precauciones especiales, horarios específicos, contraindicaciones..."
              )

            .row
              // Frecuencia
              .col-md-6.mb-3
                label.form-label(for="frecuencia")
                  i.fas.fa-clock.me-2
                  | Frecuencia
                input.form-control(
                  type="text"
                  id="frecuencia"
                  name="frecuencia"
                  placeholder="Ej: c/4hs, c/8hs, 3 veces al día"
                )
                .form-text Si aplica

              // Prioridad
              .col-md-6.mb-3
                label.form-label(for="prioridad")
                  i.fas.fa-flag.me-2
                  | Prioridad
                  span.text-danger *
                select.form-select(id="prioridad" name="prioridad" required)
                  option(value="NORMAL") Normal
                  option(value="ALTA") Alta
                  option(value="URGENTE") Urgente

            // Requiere monitoreo continuo
            .mb-3
              .form-check
                input.form-check-input(
                  type="checkbox"
                  id="requiere_monitoreo_continuo"
                  name="requiere_monitoreo_continuo"
                  value="true"
                )
                label.form-check-label(for="requiere_monitoreo_continuo")
                  i.fas.fa-heartbeat.me-2
                  | Requiere monitoreo continuo de signos vitales

            // Observaciones adicionales
            .mb-4
              label.form-label(for="observaciones_adicionales")
                i.fas.fa-notes-medical.me-2
                | Observaciones Adicionales
              textarea.form-control(
                id="observaciones_adicionales"
                name="observaciones_adicionales"
                rows="2"
                placeholder="Cualquier otra información relevante para el enfermero..."
              )

            .alert.alert-warning
              i.fas.fa-exclamation-triangle.me-2
              strong Importante:
              | Las órdenes quedarán pendientes hasta que un enfermero las ejecute. Las órdenes urgentes tendrán prioridad máxima.

            hr

            // Botones
            .d-grid.gap-2.d-md-flex.justify-content-md-end
              a.btn.btn-secondary(href="/medico/ordenes-internacion")
                i.fas.fa-times.me-2
                | Cancelar
              button.btn.btn-primary(type="button" onclick="guardarOrden()")
                i.fas.fa-save.me-2
                | Crear Orden

block scripts
  script(src="/js/medico/ordenes-internacion-crear.js")