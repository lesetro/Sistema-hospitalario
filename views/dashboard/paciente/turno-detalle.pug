extends ../../layouts/paciente-layout

block content
  .turno-detalle-paciente
    //- Breadcrumb
    nav(aria-label='breadcrumb')
      ol.breadcrumb
        li.breadcrumb-item
          a(href='/paciente') Inicio
        li.breadcrumb-item
          a(href='/paciente/turnos') Mis Turnos
        li.breadcrumb-item.active(aria-current='page') Detalle del Turno

    //- Encabezado con acciones
    .row.mb-4
      .col-md-8
        h2
          i.fas.fa-calendar-alt.text-primary.me-2
          | Detalle del Turno
        p.text-muted Turno ##{turno.id}
      .col-md-4.text-md-end
        a.btn.btn-outline-secondary(href='/paciente/turnos')
          i.fas.fa-arrow-left.me-2
          | Volver
        if puedeModificar
          button.btn.btn-danger.ms-2(onclick=`mostrarModalCancelar(${turno.id})`)
            i.fas.fa-times.me-2
            | Cancelar Turno

    //- Estado del turno
    .alert(class=turno.estado === 'CONFIRMADO' ? 'alert-success' : turno.estado === 'PENDIENTE' ? 'alert-warning' : turno.estado === 'COMPLETADO' ? 'alert-info' : 'alert-danger')
      .row.align-items-center
        .col-md-8
          h5.alert-heading
            i.fas(class=turno.estado === 'CONFIRMADO' ? 'fa-check-circle' : turno.estado === 'PENDIENTE' ? 'fa-clock' : turno.estado === 'COMPLETADO' ? 'fa-check-double' : 'fa-times-circle').me-2
            | Estado: #{turno.estado}
          if turno.estado === 'PENDIENTE'
            p.mb-0 Este turno está pendiente de confirmación. Por favor, confírmalo para asegurar tu atención.
          else if turno.estado === 'CONFIRMADO'
            p.mb-0 Tu turno está confirmado. Recuerda asistir con 15 minutos de anticipación.
          else if turno.estado === 'COMPLETADO'
            p.mb-0 Este turno ya fue completado.
          else if turno.estado === 'CANCELADO'
            p.mb-0 Este turno fue cancelado.
        .col-md-4.text-md-end
          if turno.estado === 'PENDIENTE'
            button.btn.btn-success(onclick=`confirmarTurno(${turno.id})`)
              i.fas.fa-check.me-2
              | Confirmar Turno

    .row
      //- Información del turno
      .col-lg-6.mb-4
        .card.border-0.shadow-sm.h-100
          .card-header.bg-primary.text-white
            h5.mb-0
              i.fas.fa-calendar-check.me-2
              | Información del Turno
          .card-body
            .info-group.mb-3
              label.text-muted.mb-1
                i.fas.fa-calendar.me-2
                | Fecha
              p.mb-0
                strong #{new Date(turno.fecha).toLocaleDateString('es-AR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
            
            .info-group.mb-3
              label.text-muted.mb-1
                i.fas.fa-clock.me-2
                | Horario
              p.mb-0
                strong #{turno.hora_inicio}
                if turno.hora_fin
                  |  - #{turno.hora_fin}
            
            if turno.sector
              .info-group.mb-3
                label.text-muted.mb-1
                  i.fas.fa-map-marker-alt.me-2
                  | Sector
                p.mb-0
                  strong #{turno.sector.nombre}
                  if turno.sector.descripcion
                    br
                    small.text-muted #{turno.sector.descripcion}
            
            .info-group
              label.text-muted.mb-1
                i.fas.fa-info-circle.me-2
                | Estado
              p.mb-0
                span.badge.fs-6(class=turno.estado === 'CONFIRMADO' ? 'bg-success' : turno.estado === 'PENDIENTE' ? 'bg-warning' : turno.estado === 'COMPLETADO' ? 'bg-info' : 'bg-danger')
                  | #{turno.estado}

      //- Información del profesional o estudio
      .col-lg-6.mb-4
        .card.border-0.shadow-sm.h-100
          .card-header.bg-info.text-white
            h5.mb-0
              i.fas(class=turno.medico ? 'fa-user-md' : 'fa-x-ray').me-2
              | #{turno.medico ? 'Información del Profesional' : 'Información del Estudio'}
          .card-body
            if turno.medico
              .info-group.mb-3
                label.text-muted.mb-1
                  i.fas.fa-user-md.me-2
                  | Médico
                p.mb-0
                  strong Dr/a. #{turno.medico.usuario.nombre} #{turno.medico.usuario.apellido}
              
              if turno.medico.especialidad
                .info-group.mb-3
                  label.text-muted.mb-1
                    i.fas.fa-stethoscope.me-2
                    | Especialidad
                  p.mb-0
                    strong #{turno.medico.especialidad.nombre}
                    if turno.medico.especialidad.descripcion
                      br
                      small.text-muted #{turno.medico.especialidad.descripcion}
              
              if turno.medico.usuario.telefono
                .info-group.mb-3
                  label.text-muted.mb-1
                    i.fas.fa-phone.me-2
                    | Teléfono
                  p.mb-0
                    strong #{turno.medico.usuario.telefono}
              
              if turno.medico.usuario.email
                .info-group
                  label.text-muted.mb-1
                    i.fas.fa-envelope.me-2
                    | Email
                  p.mb-0
                    strong #{turno.medico.usuario.email}
            
            else if turno.tipo_estudio
              .info-group.mb-3
                label.text-muted.mb-1
                  i.fas.fa-x-ray.me-2
                  | Tipo de Estudio
                p.mb-0
                  strong #{turno.tipo_estudio.nombre}
              
              .info-group.mb-3
                label.text-muted.mb-1
                  i.fas.fa-tag.me-2
                  | Categoría
                p.mb-0
                  span.badge.bg-secondary #{turno.tipo_estudio.categoria}
              
              if turno.tipo_estudio.requiere_ayuno
                .alert.alert-warning.mb-0
                  i.fas.fa-exclamation-triangle.me-2
                  strong Importante:
                  |  Este estudio requiere ayuno. Por favor, no consumas alimentos al menos 8 horas antes del estudio.

    //- Información adicional
    .row
      if turno.admision
        .col-lg-6.mb-4
          .card.border-0.shadow-sm.h-100
            .card-header.bg-secondary.text-white
              h5.mb-0
                i.fas.fa-clipboard-list.me-2
                | Admisión Asociada
            .card-body
              .info-group.mb-3
                label.text-muted.mb-1
                  i.fas.fa-hashtag.me-2
                  | ID Admisión
                p.mb-0
                  strong ##{turno.admision.id}
              
              if turno.admision.motivo
                .info-group.mb-3
                  label.text-muted.mb-1
                    i.fas.fa-notes-medical.me-2
                    | Motivo
                  p.mb-0
                    strong #{turno.admision.motivo.nombre}
              
              .info-group
                a.btn.btn-sm.btn-outline-primary(href=`/paciente/admisiones/${turno.admision.id}`)
                  i.fas.fa-eye.me-2
                  | Ver Admisión Completa
      
      if turno.evaluacion_medica
        .col-lg-6.mb-4
          .card.border-0.shadow-sm.h-100
            .card-header.bg-success.text-white
              h5.mb-0
                i.fas.fa-file-medical.me-2
                | Evaluación Médica
            .card-body
              .info-group.mb-3
                label.text-muted.mb-1
                  i.fas.fa-calendar.me-2
                  | Fecha de Evaluación
                p.mb-0
                  strong #{new Date(turno.evaluacion_medica.fecha).toLocaleDateString('es-AR')}
              
              if turno.evaluacion_medica.diagnostico
                .info-group.mb-3
                  label.text-muted.mb-1
                    i.fas.fa-diagnoses.me-2
                    | Diagnóstico
                  p.mb-0
                    strong #{turno.evaluacion_medica.diagnostico.nombre}
                    br
                    small.text-muted Código: #{turno.evaluacion_medica.diagnostico.codigo}
              
              .info-group
                a.btn.btn-sm.btn-outline-success(href=`/paciente/historial-medico`)
                  i.fas.fa-eye.me-2
                  | Ver en Historial

    //- Instrucciones y recomendaciones
    .card.border-0.shadow-sm.mb-4
      .card-header.bg-light
        h5.mb-0
          i.fas.fa-info-circle.me-2
          | Instrucciones y Recomendaciones
      .card-body
        .row
          .col-md-6
            h6
              i.fas.fa-check-circle.text-success.me-2
              | Antes de la Consulta
            ul
              li Llega 15 minutos antes de tu turno
              li Trae tu DNI y carnet de obra social (si corresponde)
              if turno.tipo_estudio && turno.tipo_estudio.requiere_ayuno
                li
                  strong Ayuno de 8 horas
              li Lleva estudios previos si los tienes
              li Anota tus dudas para consultarle al médico
          
          .col-md-6
            h6
              i.fas.fa-exclamation-triangle.text-warning.me-2
              | Importante
            ul
              li Si no puedes asistir, cancela el turno con anticipación
              li En caso de demora, comunícate al hospital
              li Respeta las medidas de bioseguridad
              li Si tienes síntomas de COVID-19, reprograma tu turno

    //- Acciones finales
    .text-center
      if turno.estado === 'PENDIENTE'
        button.btn.btn-success.btn-lg.me-2(onclick=`confirmarTurno(${turno.id})`)
          i.fas.fa-check.me-2
          | Confirmar Turno
      
      if puedeModificar
        button.btn.btn-danger.btn-lg(onclick=`mostrarModalCancelar(${turno.id})`)
          i.fas.fa-times.me-2
          | Cancelar Turno
      
      a.btn.btn-outline-secondary.btn-lg.ms-2(href='/paciente/turnos')
        i.fas.fa-arrow-left.me-2
        | Volver a Mis Turnos

  //- Modal para cancelar turno
  #modalCancelarTurno.modal.fade(tabindex='-1')
    .modal-dialog
      .modal-content
        .modal-header.bg-danger.text-white
          h5.modal-title
            i.fas.fa-exclamation-triangle.me-2
            | Cancelar Turno
          button.btn-close.btn-close-white(type='button', data-bs-dismiss='modal')
        .modal-body
          p ¿Estás seguro de que deseas cancelar este turno?
          .alert.alert-warning
            i.fas.fa-info-circle.me-2
            | Esta acción no se puede deshacer. El turno quedará disponible para otros pacientes.
          .mb-3
            label.form-label Motivo de cancelación (opcional)
            textarea#motivoCancelacion.form-control(rows='3', placeholder='Describe el motivo...')
        .modal-footer
          button.btn.btn-secondary(type='button', data-bs-dismiss='modal') No, mantener turno
          button#btnConfirmarCancelacion.btn.btn-danger(type='button')
            i.fas.fa-check.me-2
            | Sí, cancelar turno

block scripts
  script(src='/js/paciente/paciente-turnos.js')
