extends ../../layouts/paciente-layout

block content
  .reclamos-paciente
    .page-header.mb-4
      h2
        i.fas.fa-comment-dots.text-primary.me-2
        | Reclamos y Sugerencias

    .row.mb-4
      .col-md-4.mb-3
        .card.stat-card.border-0.shadow-sm.text-center
          .card-body
            .stat-icon.bg-primary.text-white.mb-2
              i.fas.fa-list.fa-2x
            h3.stat-number.text-primary #{estadisticas.total}
            p.stat-label.mb-0 Total
      .col-md-4.mb-3
        .card.stat-card.border-0.shadow-sm.text-center
          .card-body
            .stat-icon.bg-warning.text-white.mb-2
              i.fas.fa-clock.fa-2x
            h3.stat-number.text-warning #{estadisticas.pendientes}
            p.stat-label.mb-0 Pendientes
      .col-md-4.mb-3
        .card.stat-card.border-0.shadow-sm.text-center
          .card-body
            .stat-icon.bg-success.text-white.mb-2
              i.fas.fa-check.fa-2x
            h3.stat-number.text-success #{estadisticas.resueltos}
            p.stat-label.mb-0 Resueltos

    .card.border-0.shadow-sm.mb-4
      .card-header.bg-primary.text-white
        h5.mb-0
          i.fas.fa-plus.me-2
          | Nuevo Reclamo o Sugerencia
      .card-body
        form#formReclamo
          .mb-3
            label.form-label Mensaje
            textarea#textoReclamo.form-control(rows='4', required, placeholder='Describe tu reclamo o sugerencia...')
          button.btn.btn-primary(type='submit')
            i.fas.fa-paper-plane.me-2
            | Enviar

    .card.border-0.shadow-sm
      .card-header.bg-light
        h5.mb-0
          i.fas.fa-list.me-2
          | Mis Reclamos
      .card-body
        if reclamos && reclamos.length > 0
          .list-group.list-group-flush
            each reclamo in reclamos
              .list-group-item
                .d-flex.justify-content-between.align-items-start
                  .flex-grow-1
                    span.badge(class=reclamo.estado === 'Pendiente' ? 'bg-warning' : 'bg-success') #{reclamo.estado}
                    p.mt-2.mb-1 #{reclamo.texto}
                    small.text-muted
                      i.fas.fa-calendar.me-1
                      | #{new Date(reclamo.fecha).toLocaleDateString('es-AR')}
        else
          .text-center.py-4
            p.text-muted No tienes reclamos registrados

block scripts
  script.
    document.getElementById('formReclamo').addEventListener('submit', async (e) => {
      e.preventDefault();
      const texto = document.getElementById('textoReclamo').value;
      try {
        const res = await fetch('/paciente/reclamos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ texto })
        });
        const data = await res.json();
        if (data.success) {
          alert('Reclamo enviado exitosamente');
          location.reload();
        }
      } catch (e) { console.error(e); }
    });
