extends ../../layouts/paciente-layout

block content
  .lista-espera-paciente
    //- Encabezado
    .page-header.mb-4
      .row.align-items-center
        .col-md-8
          h2
            i.fas.fa-clock.text-info.me-2
            | Lista de Espera
          p.text-muted Seguimiento de tus solicitudes de turno

    //- Estadísticas rápidas
    .row.mb-4
      .col-md-3.col-sm-6.mb-3
        .card.stat-card.border-0.shadow-sm.text-center
          .card-body
            .stat-icon.bg-info.text-white.mb-2
              i.fas.fa-list.fa-2x
            h3.stat-number.text-info #{estadisticas.total}
            p.stat-label.mb-0 Total Solicitudes
      
      .col-md-3.col-sm-6.mb-3
        .card.stat-card.border-0.shadow-sm.text-center
          .card-body
            .stat-icon.bg-warning.text-white.mb-2
              i.fas.fa-hourglass-half.fa-2x
            h3.stat-number.text-warning #{estadisticas.pendientes}
            p.stat-label.mb-0 Pendientes
      
      .col-md-3.col-sm-6.mb-3
        .card.stat-card.border-0.shadow-sm.text-center
          .card-body
            .stat-icon.bg-primary.text-white.mb-2
              i.fas.fa-check-circle.fa-2x
            h3.stat-number.text-primary #{estadisticas.asignados}
            p.stat-label.mb-0 Asignados
      
      .col-md-3.col-sm-6.mb-3
        .card.stat-card.border-0.shadow-sm.text-center
          .card-body
            .stat-icon.bg-success.text-white.mb-2
              i.fas.fa-check-double.fa-2x
            h3.stat-number.text-success #{estadisticas.completados}
            p.stat-label.mb-0 Completados

    //- Alertas
    if estadisticas.prioridadAlta > 0
      .alert.alert-danger.mb-4
        i.fas.fa-exclamation-triangle.me-2
        strong Atención:
        |  Tienes #{estadisticas.prioridadAlta} solicitud#{estadisticas.prioridadAlta > 1 ? 'es' : ''} de prioridad alta en proceso.

    //- Filtros
    .card.border-0.shadow-sm.mb-4
      .card-body
        form#formFiltros(method='GET', action='/paciente/lista-espera')
          .row.g-3
            .col-md-4
              label.form-label Estado
              select.form-select(name='estado')
                option(value='', selected=!filtros.estado) Todos
                option(value='PENDIENTE', selected=filtros.estado === 'PENDIENTE') Pendiente
                option(value='ASIGNADO', selected=filtros.estado === 'ASIGNADO') Asignado
                option(value='COMPLETADO', selected=filtros.estado === 'COMPLETADO') Completado
                option(value='CANCELADO', selected=filtros.estado === 'CANCELADO') Cancelado
            
            .col-md-4
              label.form-label Prioridad
              select.form-select(name='prioridad')
                option(value='', selected=!filtros.prioridad) Todas
                option(value='ALTA', selected=filtros.prioridad === 'ALTA') Alta
                option(value='MEDIA', selected=filtros.prioridad === 'MEDIA') Media
                option(value='BAJA', selected=filtros.prioridad === 'BAJA') Baja
            
            .col-md-4.d-flex.align-items-end
              button.btn.btn-primary.w-100(type='submit')
                i.fas.fa-filter.me-2
                | Filtrar
              button.btn.btn-secondary.ms-2(type='button', onclick='limpiarFiltros()')
                i.fas.fa-times

    //- Lista de solicitudes
    .card.border-0.shadow-sm
      .card-header.bg-light
        h5.mb-0
          i.fas.fa-list.me-2
          | Mis Solicitudes
          small.text-muted.ms-2 (#{paginacion.totalItems} solicitudes)
      
      .card-body
        if listasEspera && listasEspera.length > 0
          .list-group.list-group-flush
            each solicitud in listasEspera
              .list-group-item
                .row.align-items-center
                  .col-md-8
                    .d-flex.align-items-start
                      .flex-shrink-0.me-3
                        if solicitud.estado === 'PENDIENTE'
                          .status-icon.bg-warning.text-white
                            i.fas.fa-hourglass-half
                        else if solicitud.estado === 'ASIGNADO'
                          .status-icon.bg-primary.text-white
                            i.fas.fa-check-circle
                        else if solicitud.estado === 'COMPLETADO'
                          .status-icon.bg-success.text-white
                            i.fas.fa-check-double
                        else if solicitud.estado === 'CANCELADO'
                          .status-icon.bg-danger.text-white
                            i.fas.fa-times-circle
                      
                      .flex-grow-1
                        .d-flex.align-items-center.mb-2
                          h6.mb-0.me-2 #{solicitud.tipo_turno.nombre}
                          span.badge(class=solicitud.prioridad === 'ALTA' ? 'bg-danger' : solicitud.prioridad === 'MEDIA' ? 'bg-warning' : 'bg-secondary')
                            | #{solicitud.prioridad}
                          span.badge.bg-info.ms-2 #{solicitud.estado}
                        
                        if solicitud.especialidad
                          p.mb-1.text-muted
                            i.fas.fa-stethoscope.me-2
                            | #{solicitud.especialidad.nombre}
                        else if solicitud.tipo_estudio
                          p.mb-1.text-muted
                            i.fas.fa-x-ray.me-2
                            | #{solicitud.tipo_estudio.nombre}
                            span.badge.bg-secondary.ms-2 #{solicitud.tipo_estudio.categoria}
                        
                        p.mb-1
                          small.text-muted
                            i.fas.fa-calendar.me-2
                            | Registrado: #{new Date(solicitud.fecha_registro).toLocaleDateString('es-AR')}
                        
                        if solicitud.estado === 'PENDIENTE' && solicitud.dataValues.posicionEnCola
                          p.mb-0
                            small.badge.bg-warning
                              i.fas.fa-sort-numeric-down.me-1
                              | Posición en cola: #{solicitud.dataValues.posicionEnCola}
                        
                        if solicitud.turno
                          .alert.alert-success.mt-2.mb-0.py-2
                            i.fas.fa-calendar-check.me-2
                            strong Turno asignado:
                            |  #{new Date(solicitud.turno.fecha).toLocaleDateString('es-AR')} a las #{solicitud.turno.hora_inicio}
                            br
                            a.btn.btn-sm.btn-success.mt-1(href=`/paciente/turnos/${solicitud.turno.id}`)
                              i.fas.fa-eye.me-1
                              | Ver Turno
                  
                  .col-md-4.text-md-end
                    .btn-group(role='group')
                      a.btn.btn-sm.btn-outline-primary(href=`/paciente/lista-espera/${solicitud.id}`, title='Ver Detalle')
                        i.fas.fa-eye
                      
                      if ['PENDIENTE', 'ASIGNADO'].includes(solicitud.estado)
                        button.btn.btn-sm.btn-outline-danger(
                          onclick=`mostrarModalCancelar(${solicitud.id})`,
                          title='Cancelar Solicitud'
                        )
                          i.fas.fa-times

          //- Paginación
          if paginacion.totalPages > 1
            nav.mt-4(aria-label='Paginación')
              ul.pagination.justify-content-center
                li.page-item(class=!paginacion.hasPrev ? 'disabled' : '')
                  a.page-link(href=`?page=${paginacion.currentPage - 1}&estado=${filtros.estado || ''}&prioridad=${filtros.prioridad || ''}`) Anterior
                
                - for (let i = 1; i <= paginacion.totalPages; i++)
                  li.page-item(class=i === paginacion.currentPage ? 'active' : '')
                    a.page-link(href=`?page=${i}&estado=${filtros.estado || ''}&prioridad=${filtros.prioridad || ''}`) #{i}
                
                li.page-item(class=!paginacion.hasNext ? 'disabled' : '')
                  a.page-link(href=`?page=${paginacion.currentPage + 1}&estado=${filtros.estado || ''}&prioridad=${filtros.prioridad || ''}`) Siguiente
        else
          .text-center.py-5
            i.fas.fa-inbox.fa-4x.text-muted.mb-3
            h5.text-muted No tienes solicitudes en lista de espera
            p.text-muted Solicita un turno para comenzar en el hospital
            

    //- Información adicional
    .row.mt-4
      .col-md-6
        .card.border-0.shadow-sm
          .card-header.bg-info.text-white
            h6.mb-0
              i.fas.fa-info-circle.me-2
              | ¿Cómo funciona la lista de espera?
          .card-body
            ol.mb-0
              li Envías una solicitud de turno
              li Tu solicitud entra en lista de espera según prioridad
              li El personal administrativo asigna turnos disponibles
              li Recibes una notificación cuando se asigne tu turno
              li Puedes confirmar o cancelar el turno asignado

      .col-md-6
        .card.border-0.shadow-sm
          .card-header.bg-secondary.text-white
            h6.mb-0
              i.fas.fa-sort-amount-down.me-2
              | Prioridades
          .card-body
            .mb-2
              span.badge.bg-danger.me-2 ALTA
              | Casos urgentes, atención prioritaria
            .mb-2
              span.badge.bg-warning.me-2 MEDIA
              | Atención regular, según disponibilidad
            .mb-0
              span.badge.bg-secondary.me-2 BAJA
              | Atención programada

  //- Modal para cancelar solicitud
  #modalCancelarSolicitud.modal.fade(tabindex='-1')
    .modal-dialog
      .modal-content
        .modal-header.bg-danger.text-white
          h5.modal-title
            i.fas.fa-exclamation-triangle.me-2
            | Cancelar Solicitud
          button.btn-close.btn-close-white(type='button', data-bs-dismiss='modal')
        .modal-body
          p ¿Estás seguro de que deseas cancelar esta solicitud?
          .alert.alert-warning
            i.fas.fa-info-circle.me-2
            | Si la solicitud tiene un turno asignado, también se cancelará el turno.
          .mb-3
            label.form-label Motivo de cancelación (opcional)
            textarea#motivoCancelacion.form-control(rows='3', placeholder='Describe el motivo...')
        .modal-footer
          button.btn.btn-secondary(type='button', data-bs-dismiss='modal') No, mantener solicitud
          button#btnConfirmarCancelacion.btn.btn-danger(type='button')
            i.fas.fa-check.me-2
            | Sí, cancelar solicitud

block scripts
  script(src='/js/paciente/paciente-lista-espera.js')
