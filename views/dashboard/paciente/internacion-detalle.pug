extends ../../layouts/paciente-layout

block content
  .container-fluid
    nav(aria-label='breadcrumb')
      ol.breadcrumb
        li.breadcrumb-item
          a(href='/paciente') Inicio
        li.breadcrumb-item
          a(href='/paciente/internaciones') Mis Internaciones
        li.breadcrumb-item.active Detalle de Internación ##{internacion.id}

    .d-flex.justify-content-between.align-items-center.mb-4
      h2.mb-0
        i.fas.fa-bed.me-2.text-primary
        | Detalle de Internación
      .btn-group
        a.btn.btn-outline-secondary(href='/paciente/internaciones')
          i.fas.fa-arrow-left.me-2
          | Volver
        button#actualizarEstado.btn.btn-outline-info(type='button')
          i.fas.fa-sync-alt.me-2
          | Actualizar Estado

    // Estado dinámico
    #estadoInternacion.alert(class=estaActiva ? 'alert-warning' : 'alert-info')
      h5.alert-heading
        if estaActiva
          i.fas.fa-bed.me-2
          | Internación en Curso
        else
          i.fas.fa-check-circle.me-2
          | Internación Finalizada
      p.mb-0
        if estaActiva
          | Estás internado desde el #{new Date(internacion.fecha_inicio).toLocaleDateString('es-AR')}
          br
          | Duración actual: #{duracion} días
        else
          | Internación del #{new Date(internacion.fecha_inicio).toLocaleDateString('es-AR')} 
          if internacion.fecha_alta
            | al #{new Date(internacion.fecha_alta).toLocaleDateString('es-AR')}
          else if tieneAltaMedica && internacion.altasMedicas[0]
            | al #{new Date(internacion.altasMedicas[0].fecha_alta).toLocaleDateString('es-AR')}
          br
          | Duración total: #{duracion} días
      small#estadoActualizado.text-muted.mt-2.d-block

    .row.g-4
      .col-lg-6
        .card.shadow-sm.border-0
          .card-header.bg-primary.text-white
            h5.mb-0 Información General
          .card-body
            dl.row
              dt.col-sm-4 ID Internación
              dd.col-sm-8 ##{internacion.id}
              dt.col-sm-4 Fecha ingreso
              dd.col-sm-8 #{new Date(internacion.fecha_inicio).toLocaleString('es-AR')}
              if internacion.fecha_alta
                dt.col-sm-4 Fecha alta
                dd.col-sm-8 #{new Date(internacion.fecha_alta).toLocaleString('es-AR')}
              else if tieneAltaMedica && internacion.altasMedicas[0]
                dt.col-sm-4 Fecha alta médica
                dd.col-sm-8 #{new Date(internacion.altasMedicas[0].fecha_alta).toLocaleString('es-AR')}
              dt.col-sm-4 Tipo
              dd.col-sm-8 #{internacion.tipoInternacion ? internacion.tipoInternacion.nombre : '-'}
              dt.col-sm-4 Sector
              dd.col-sm-8 #{internacion.habitacion && internacion.habitacion.sector ? internacion.habitacion.sector.nombre : '-'}
              dt.col-sm-4 Habitación
              dd.col-sm-8
                | #{internacion.habitacion ? internacion.habitacion.numero : '-'}
                |  (#{internacion.habitacion ? internacion.habitacion.tipo : '-'})
              dt.col-sm-4 Cama
              dd.col-sm-8 #{internacion.cama ? internacion.cama.numero : '-'}

      .col-lg-6
        .card.shadow-sm.border-0
          .card-header.bg-info.text-white
            h5.mb-0 Médico Tratante
          .card-body
            if internacion.medico
              dl.row
                dt.col-sm-4 Médico
                dd.col-sm-8 Dr/a. #{internacion.medico.usuario.nombre} #{internacion.medico.usuario.apellido}
                dt.col-sm-4 Especialidad
                dd.col-sm-8 #{internacion.medico.especialidad ? internacion.medico.especialidad.nombre : '-'}
                dt.col-sm-4 Teléfono
                dd.col-sm-8 #{internacion.medico.usuario.telefono || '-'}
                dt.col-sm-4 Email
                dd.col-sm-8 #{internacion.medico.usuario.email || '-'}

      if internacion.admision
        .col-12
          .card.shadow-sm.border-0
            .card-header.bg-secondary.text-white
              h5.mb-0 Admisión Asociada
            .card-body
              dl.row
                dt.col-sm-3 ID Admisión
                dd.col-sm-9 ##{internacion.admision.id}
                dt.col-sm-3 Motivo
                dd.col-sm-9 #{internacion.admision.motivo ? internacion.admision.motivo.nombre : '-'}
                dt.col-sm-3 Fecha
                dd.col-sm-9 #{new Date(internacion.admision.fecha).toLocaleDateString('es-AR')}
                dt.col-sm-3 Estado
                dd.col-sm-9 
                  span.badge(class=internacion.admision.estado === 'Completada' ? 'bg-success' : 'bg-warning')
                    | #{internacion.admision.estado}

      if internacion.intervencionQuirurgica
        .col-12
          .card.shadow-sm.border-0
            .card-header.bg-warning.text-dark
              h5.mb-0 Intervención Quirúrgica
            .card-body
              p.mb-1 Tipo: #{internacion.intervencionQuirurgica.tipo_procedimiento}
              if internacion.intervencionQuirurgica.resultado_cirugia
                p.mb-0 Resultado: #{internacion.intervencionQuirurgica.resultado_cirugia}

      if internacion.altasMedicas && internacion.altasMedicas.length > 0
        .col-12
          .card.shadow-sm.border-0
            .card-header.bg-success.text-white
              h5.mb-0 Alta Médica
            .card-body
              each alta in internacion.altasMedicas
                .mb-3.p-3.bg-light.rounded
                  h6
                    i.fas.fa-file-medical.me-2
                    | Alta del #{new Date(alta.fecha_alta).toLocaleDateString('es-AR')}
                  dl.row.mb-0
                    dt.col-sm-3 Tipo
                    dd.col-sm-9 
                      span.badge(class=alta.tipo_alta === 'Medica' ? 'bg-success' : alta.tipo_alta === 'Voluntaria' ? 'bg-warning' : 'bg-danger')
                        | #{alta.tipo_alta}
                    dt.col-sm-3 Estado paciente
                    dd.col-sm-9 
                      span.badge(class=alta.estado_paciente === 'Estable' ? 'bg-success' : alta.estado_paciente === 'Grave' ? 'bg-warning' : 'bg-danger')
                        | #{alta.estado_paciente}
                    dt.col-sm-3 Médico
                    dd.col-sm-9 Dr/a. #{alta.medico ? alta.medico.usuario.nombre + ' ' + alta.medico.usuario.apellido : 'No especificado'}
                    if alta.instrucciones_post_alta
                      dt.col-sm-3 Instrucciones
                      dd.col-sm-9 #{alta.instrucciones_post_alta}

block scripts
  script.
    // Datos iniciales
    const pacienteId = "#{pacienteId}";
    const internacionId = "#{internacionId}";
    const estadoInicial = {
      estaActiva: #{estaActiva},
      tieneAltaMedica: #{tieneAltaMedica},
      fechaAlta: "#{internacion.fecha_alta || ''}",
      fechaAltaMedica: "#{tieneAltaMedica && internacion.altasMedicas[0] ? internacion.altasMedicas[0].fecha_alta : ''}",
      estadoPaciente: "#{pacienteEstado || ''}"
    };

    // Función para actualizar estado visual
    function actualizarEstadoVisual(data) {
      const alertDiv = document.getElementById('estadoInternacion');
      const titulo = alertDiv.querySelector('.alert-heading');
      const mensaje = alertDiv.querySelector('p.mb-0');
      const actualizado = document.getElementById('estadoActualizado');
      
      if (data.estaActiva) {
        alertDiv.className = 'alert alert-warning';
        titulo.innerHTML = '<i class="fas fa-bed me-2"></i> Internación en Curso';
        mensaje.innerHTML = `
          Estás internado desde el ${new Date('#{internacion.fecha_inicio}').toLocaleDateString('es-AR')}<br>
          Duración actual: ${data.duracion || 0} días
        `;
      } else {
        alertDiv.className = 'alert alert-info';
        titulo.innerHTML = '<i class="fas fa-check-circle me-2"></i> Internación Finalizada';
        const fechaFin = data.fechaAlta || data.fechaAltaMedica || '#{internacion.fecha_inicio}';
        mensaje.innerHTML = `
          Internación del ${new Date('#{internacion.fecha_inicio}').toLocaleDateString('es-AR')} al ${new Date(fechaFin).toLocaleDateString('es-AR')}<br>
          Duración total: ${data.duracion || 0} días
        `;
      }
      
      actualizado.textContent = `Actualizado: ${new Date().toLocaleTimeString('es-AR')}`;
    }

    // Función para consultar estado actual
    async function consultarEstadoActual() {
      try {
        const response = await fetch(`/paciente/internaciones/${internacionId}/estado`, {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        });
        
        if (!response.ok) {
          throw new Error('Error en la consulta');
        }
        
        const data = await response.json();
        
        if (data.success) {
          actualizarEstadoVisual(data);
          mostrarToast('Estado actualizado correctamente', 'success');
        } else {
          mostrarToast(data.message || 'Error al actualizar', 'danger');
        }
        
      } catch (error) {
        console.error('Error al consultar estado:', error);
        mostrarToast('Error al actualizar estado', 'danger');
      }
    }

    // Función para mostrar notificación
    function mostrarToast(mensaje, tipo = 'info') {
      let toastContainer = document.getElementById('toastContainer');
      if (!toastContainer) {
        toastContainer = document.createElement('div');
        toastContainer.id = 'toastContainer';
        toastContainer.className = 'toast-container position-fixed bottom-0 end-0 p-3';
        document.body.appendChild(toastContainer);
      }
      
      const toastId = 'toast-' + Date.now();
      const toastHtml = `
        <div id="${toastId}" class="toast align-items-center text-bg-${tipo} border-0" role="alert">
          <div class="d-flex">
            <div class="toast-body">${mensaje}</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
          </div>
        </div>
      `;
      
      toastContainer.innerHTML += toastHtml;
      const toastEl = document.getElementById(toastId);
      const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
      toast.show();
      
      toastEl.addEventListener('hidden.bs.toast', () => {
        toastEl.remove();
      });
    }

    // Inicializar
    document.addEventListener('DOMContentLoaded', function() {
      // Configurar estado inicial
      actualizarEstadoVisual(estadoInicial);
      
      // Configurar botón de actualizar
      document.getElementById('actualizarEstado').addEventListener('click', consultarEstadoActual);
      
      // Actualizar automáticamente cada 5 minutos
      setInterval(consultarEstadoActual, 5 * 60 * 1000);
    });