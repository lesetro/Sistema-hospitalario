extends ../../layouts/paciente-layout

block content
  .dashboard-paciente
    //- Alerta de internación activa
    if internacionActiva
      .alert.alert-warning.alert-dismissible.fade.show(role='alert')
        i.fas.fa-bed.me-2
        strong Internación Activa
        |  Actualmente se encuentra internado en #{internacionActiva.cama.habitacion.tipo} - Habitación #{internacionActiva.cama.habitacion.numero}, Cama #{internacionActiva.cama.numero}
        button.btn-close(type='button', data-bs-dismiss='alert')

    //- Bienvenida
    .welcome-section.mb-4
      .card.border-0.shadow-sm
        .card-body.p-4
          .row.align-items-center
            .col-md-8
              h2.mb-2
                i.fas.fa-user-circle.text-primary.me-2
                | Bienvenido/a, #{user.nombre} #{user.apellido}
              p.text-muted.mb-2
                i.fas.fa-id-card.me-2
                | DNI: #{user.dni}
                span.mx-3 |
                i.fas.fa-birthday-cake.me-2
                | #{user.edad} años
                span.mx-3 |
                i.fas.fa-venus-mars.me-2
                | #{user.sexo}
              if user.obra_social !== 'Sin Obra Social'
                p.mb-0
                  span.badge.bg-success.fs-6
                    i.fas.fa-shield-alt.me-2
                    | #{user.obra_social}
              else
                p.mb-0
                  span.badge.bg-info.fs-6
                    i.fas.fa-hospital.me-2
                    | Sistema Público
            .col-md-4.text-center
              .estado-badge
                if paciente.estado === 'Activo'
                  span.badge.bg-success.fs-5.p-3
                    i.fas.fa-check-circle.me-2
                    | Estado: Activo
                else if paciente.estado === 'Inactivo'
                  span.badge.bg-warning.fs-5.p-3
                    i.fas.fa-pause-circle.me-2
                    | Estado: Inactivo

    //- Estadísticas rápidas
    .row.mb-4
      .col-md-3.col-sm-6.mb-3
        .card.stat-card.border-0.shadow-sm.h-100
          .card-body.text-center
            .stat-icon.bg-primary.text-white.mb-3
              i.fas.fa-calendar-check.fa-2x
            h3.stat-number.text-primary #{contadores.turnos}
            p.stat-label Próximos Turnos
            a.btn.btn-sm.btn-outline-primary(href='/paciente/turnos') Ver todos
      
      .col-md-3.col-sm-6.mb-3
        .card.stat-card.border-0.shadow-sm.h-100
          .card-body.text-center
            .stat-icon.bg-warning.text-white.mb-3
              i.fas.fa-file-invoice-dollar.fa-2x
            h3.stat-number.text-warning #{contadores.facturas}
            p.stat-label Facturas Pendientes
            if totalDeuda > 0
              p.text-danger.fw-bold.mb-2 $#{totalDeuda.toFixed(2)}
            a.btn.btn-sm.btn-outline-warning(href='/paciente/facturas') Ver facturas
      
      .col-md-3.col-sm-6.mb-3
        .card.stat-card.border-0.shadow-sm.h-100
          .card-body.text-center
            .stat-icon.bg-info.text-white.mb-3
              i.fas.fa-clock.fa-2x
            h3.stat-number.text-info #{contadores.listaEspera}
            p.stat-label En Lista de Espera
            a.btn.btn-sm.btn-outline-info(href='/paciente/lista-espera') Ver lista
      
      .col-md-3.col-sm-6.mb-3
        .card.stat-card.border-0.shadow-sm.h-100
          .card-body.text-center
            .stat-icon.bg-danger.text-white.mb-3
              i.fas.fa-bell.fa-2x
            h3.stat-number.text-danger #{contadores.notificaciones}
            p.stat-label Notificaciones
            a.btn.btn-sm.btn-outline-danger(href='/paciente/notificaciones') Ver todas

    .row
      //- Próximos turnos
      .col-lg-6.mb-4
        .card.border-0.shadow-sm.h-100
          .card-header.bg-primary.text-white
            h5.mb-0
              i.fas.fa-calendar-alt.me-2
              | Próximos Turnos
          .card-body
            if proximosTurnos && proximosTurnos.length > 0
              .list-group.list-group-flush
                each turno in proximosTurnos
                  .list-group-item.px-0
                    .d-flex.justify-content-between.align-items-start
                      .turno-info
                        h6.mb-1
                          span.badge(class=turno.estado === 'CONFIRMADO' ? 'bg-success' : 'bg-warning')
                            | #{turno.estado}
                        p.mb-1
                          i.fas.fa-calendar.text-muted.me-2
                          strong #{new Date(turno.fecha).toLocaleDateString('es-AR')}
                          span.mx-2 |
                          i.fas.fa-clock.text-muted.me-2
                          | #{turno.hora_inicio}
                        if turno.medico
                          p.mb-1.text-muted
                            i.fas.fa-user-md.me-2
                            | Dr/a. #{turno.medico.usuario.nombre} #{turno.medico.usuario.apellido}
                            if turno.medico.especialidad
                              br
                              small
                                i.fas.fa-stethoscope.me-2
                                | #{turno.medico.especialidad.nombre}
                        else if turno.tipo_estudio
                          p.mb-1.text-muted
                            i.fas.fa-x-ray.me-2
                            | #{turno.tipo_estudio.nombre}
                        if turno.sector
                          p.mb-0
                            small.text-muted
                              i.fas.fa-map-marker-alt.me-2
                              | #{turno.sector.nombre}
                      div
                        a.btn.btn-sm.btn-outline-primary(href=`/paciente/turnos/${turno.id}`)
                          i.fas.fa-eye
              .text-center.mt-3
                a.btn.btn-primary(href='/paciente/turnos') Ver todos mis turnos
            else
              .text-center.py-4
                i.fas.fa-calendar-times.fa-3x.text-muted.mb-3
                p.text-muted Proximamente, sigue en desarrollo
                a.btn.btn-primary(href='#')
                  i.fas.fa-plus.me-2
                  | Solicitar Turno

      //- Lista de espera
      .col-lg-6.mb-4
        .card.border-0.shadow-sm.h-100
          .card-header.bg-info.text-white
            h5.mb-0
              i.fas.fa-clock.me-2
              | Lista de Espera
          .card-body
            if listasEspera && listasEspera.length > 0
              .list-group.list-group-flush
                each lista in listasEspera
                  .list-group-item.px-0
                    .d-flex.justify-content-between.align-items-start
                      div
                        h6.mb-1
                          span.badge(class=lista.prioridad === 'ALTA' ? 'bg-danger' : lista.prioridad === 'MEDIA' ? 'bg-warning' : 'bg-secondary')
                            | #{lista.prioridad}
                          span.badge.bg-info.ms-2 #{lista.estado}
                        p.mb-1
                          strong #{lista.tipo_turno.nombre}
                        if lista.especialidad
                          p.mb-1.text-muted
                            i.fas.fa-stethoscope.me-2
                            | #{lista.especialidad.nombre}
                        else if lista.tipo_estudio
                          p.mb-1.text-muted
                            i.fas.fa-x-ray.me-2
                            | #{lista.tipo_estudio.nombre}
                        p.mb-0
                          small.text-muted
                            i.fas.fa-calendar.me-2
                            | Registrado: #{new Date(lista.fecha_registro).toLocaleDateString('es-AR')}
                      div
                        a.btn.btn-sm.btn-outline-info(href=`/paciente/lista-espera/${lista.id}`)
                          i.fas.fa-eye
              .text-center.mt-3
                a.btn.btn-info.text-white(href='/paciente/lista-espera') Ver lista completa
            else
              .text-center.py-4
                i.fas.fa-clipboard-check.fa-3x.text-muted.mb-3
                p.text-muted No tienes solicitudes en lista de espera

    .row
      //- Facturas pendientes
      .col-lg-6.mb-4
        .card.border-0.shadow-sm.h-100
          .card-header.bg-warning.text-dark
            h5.mb-0
              i.fas.fa-file-invoice-dollar.me-2
              | Facturas Pendientes
          .card-body
            if facturasPendientes && facturasPendientes.length > 0
              .alert.alert-warning.mb-3
                i.fas.fa-exclamation-triangle.me-2
                strong Total adeudado: $#{totalDeuda.toFixed(2)}
              .list-group.list-group-flush
                each factura in facturasPendientes
                  .list-group-item.px-0
                    .d-flex.justify-content-between.align-items-center
                      div
                        p.mb-1
                          strong Factura ##{factura.id}
                        p.mb-1
                          i.fas.fa-calendar.text-muted.me-2
                          | #{new Date(factura.fecha_emision).toLocaleDateString('es-AR')}
                        if factura.descripcion
                          p.mb-0
                            small.text-muted #{factura.descripcion}
                      div.text-end
                        h5.text-danger.mb-0 $#{parseFloat(factura.monto).toFixed(2)}
                        a.btn.btn-sm.btn-warning.mt-2(href=`/paciente/facturas/${factura.id}`)
                          i.fas.fa-eye.me-1
                          | Ver
              .text-center.mt-3
                a.btn.btn-warning(href='/paciente/facturas') Ver todas las facturas
            else
              .text-center.py-4
                i.fas.fa-check-circle.fa-3x.text-success.mb-3
                p.text-success No tienes facturas pendientes

      //- Notificaciones recientes
      .col-lg-6.mb-4
        .card.border-0.shadow-sm.h-100
          .card-header.bg-danger.text-white
            h5.mb-0
              i.fas.fa-bell.me-2
              | Notificaciones Recientes
          .card-body
            if notificaciones && notificaciones.length > 0
              .list-group.list-group-flush
                each notif in notificaciones
                  .list-group-item.px-0
                    .d-flex.align-items-start
                      .flex-shrink-0
                        i.fas.fa-circle.text-danger.small.mt-1
                      .flex-grow-1.ms-3
                        p.mb-1 #{notif.mensaje}
                        small.text-muted
                          i.fas.fa-clock.me-1
                          | #{new Date(notif.createdAt).toLocaleString('es-AR')}
              .text-center.mt-3
                a.btn.btn-danger(href='/paciente/notificaciones') Ver todas las notificaciones
            else
              .text-center.py-4
                i.fas.fa-bell-slash.fa-3x.text-muted.mb-3
                p.text-muted No tienes notificaciones nuevas

    //- Información adicional
    .row
      .col-lg-12.mb-4
        .card.border-0.shadow-sm
          .card-header.bg-secondary.text-white
            h5.mb-0
              i.fas.fa-info-circle.me-2
              | Resumen de mi Historial
          .card-body
            .row.text-center
              .col-md-3.mb-3
                .stat-box
                  i.fas.fa-calendar-check.fa-2x.text-primary.mb-2
                  h4.mb-0 #{estadisticas.totalTurnos}
                  small.text-muted Total de Turnos
              .col-md-3.mb-3
                .stat-box
                  i.fas.fa-check-double.fa-2x.text-success.mb-2
                  h4.mb-0 #{estadisticas.turnosCompletados}
                  small.text-muted Turnos Completados
              .col-md-3.mb-3
                .stat-box
                  i.fas.fa-clipboard-list.fa-2x.text-info.mb-2
                  h4.mb-0 #{estadisticas.totalAdmisiones}
                  small.text-muted Total Admisiones
              .col-md-3.mb-3
                .stat-box
                  i.fas.fa-file-invoice.fa-2x.text-warning.mb-2
                  h4.mb-0 #{estadisticas.totalFacturas}
                  small.text-muted Total Facturas

    //- Última admisión
    if ultimaAdmision
      .row
        .col-lg-12.mb-4
          .card.border-0.shadow-sm
            .card-header.bg-light
              h5.mb-0
                i.fas.fa-clipboard-list.me-2
                | Última Admisión
            .card-body
              .row
                .col-md-6
                  p.mb-2
                    strong Fecha:
                    span.ms-2 #{new Date(ultimaAdmision.fecha).toLocaleDateString('es-AR')}
                  p.mb-2
                    strong Motivo:
                    span.ms-2 #{ultimaAdmision.motivo.nombre}
                  if ultimaAdmision.sector
                    p.mb-0
                      strong Sector:
                      span.ms-2 #{ultimaAdmision.sector.nombre}
                .col-md-6.text-md-end
                  span.badge(class=ultimaAdmision.estado === 'Completada' ? 'bg-success' : ultimaAdmision.estado === 'Pendiente' ? 'bg-warning' : 'bg-danger')
                    | #{ultimaAdmision.estado}
                  br
                  a.btn.btn-sm.btn-outline-primary.mt-2(href=`/paciente/admisiones/${ultimaAdmision.id}`)
                    i.fas.fa-eye.me-1
                    | Ver detalles

block scripts
  script(src='/js/paciente/paciente-dashboard.js')
