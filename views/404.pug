doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Error 404 - Página No Encontrada
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css', rel='stylesheet')
    link(rel='stylesheet', href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    style.
      body {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
      }
      .error-illustration {
        max-width: 300px;
        margin: 0 auto 2rem;
      }
      .search-box {
        position: relative;
        max-width: 500px;
        margin: 2rem auto;
      }
      .floating {
        animation: floating 3s ease-in-out infinite;
      }
      @keyframes floating {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
      }

  body
    .container.min-vh-100.d-flex.flex-column.justify-content-center
      .row.justify-content-center
        .col-md-8.text-center
          .floating.mb-4
            i.fas.fa-search.text-primary(style='font-size: 120px; opacity: 0.7;')
          
          h1.display-1.fw-bold.text-primary.mb-3 404
          h2.text-secondary.mb-4 Página No Encontrada
          
          p.lead.mb-4
            | La página que buscas podría haber sido removida,<br>cambiado su nombre o no está disponible temporalmente.
          
          .search-box.mb-5
            .input-group.input-group-lg
              input.form-control(type='text', placeholder='¿Qué estás buscando?', id='searchInput')
              button.btn.btn-primary(type='button', onclick='buscar()')
                i.fas.fa-search
          
          .row.mt-4
            .col-md-4.mb-3
              a.btn.btn-outline-primary.btn-lg.w-100(href='/')
                i.fas.fa-home.me-2
                | Inicio
            .col-md-4.mb-3
              a.btn.btn-outline-success.btn-lg.w-100(href='/pacientes')
                i.fas.fa-user-injured.me-2
                | Pacientes
            .col-md-4.mb-3
              a.btn.btn-outline-info.btn-lg.w-100(href='/triaje')
                i.fas.fa-stethoscope.me-2
                | Triaje
            
          .mt-5
            p.text-muted
              i.fas.fa-lightbulb.me-2
              | Sugerencia: Verifica la URL o navega desde el menú principal
            a.small.text-decoration-none(href='/mapa-sitio')
              i.fas.fa-sitemap.me-1
              | Ver mapa del sitio


    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')