//- error.pug - Versión reutilizable
doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= `${errorCode} - ${titulo}`
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css', rel='stylesheet')
    style.
      body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
      }
      .error-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
      }

  body
    .container.min-vh-100.d-flex.align-items-center
      .row.justify-content-center.w-100
        .col-md-8.col-lg-6
          .error-card.p-5.text-center
            h1.display-1.fw-bold.text-primary= errorCode
            h2.text-secondary.mb-4= titulo
            p.lead.mb-4= descripcion
            .d-grid.gap-3
              a.btn.btn-primary.btn-lg(href='/')
                | Volver al Inicio
              a.btn.btn-outline-secondary.btn-lg(
                href='javascript:history.back()'
              )
                | Volver Atrás
              if errorCode === 403
                a.btn.btn-outline-dark.btn-lg(
                  href='mailto:admin@hospital.com'
                )
                  | Contactar Administrador

